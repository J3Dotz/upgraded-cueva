# Sanity
SANITY_PROJECT_ID=e4tsjl4a
SANITY_DATASET=production
# Generate at https://www.sanity.io/manage → API → Tokens
# Only needed for write operations (mutations); read uses the public CDN
SANITY_API_TOKEN=

# Resend — get at https://resend.com/api-keys
RESEND_API_KEY=

# Astro site URL (used for canonical tags)
SITE_URL=https://lacuevademiravet.com

# Sanity webhook — used by /api/revalidate to verify incoming webhook signatures.
# Generate at: Sanity Manage → API → Webhooks → (your webhook) → Signing secret
# Use a long random string: openssl rand -hex 32
SANITY_WEBHOOK_SECRET=

# Vercel Deploy Hook — the endpoint revalidate.ts calls to trigger a rebuild.
# Generate at: Vercel → Project → Settings → Git → Deploy Hooks
# Create a hook for the "main" branch and paste the URL here.
VERCEL_DEPLOY_HOOK_URL=
