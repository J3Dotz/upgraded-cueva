---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SanityVisualEditing from '../components/SanityVisualEditing.tsx';
import DisableDraftMode from '../components/DisableDraftMode.tsx';
import '../styles/global.css';
import { type Lang } from '../i18n/ui';
import { client } from '../lib/sanity';
import { SITE_SETTINGS_QUERY } from '../lib/sanity/queries';
import type { SiteSettings } from '../types/sanity';
import { perspectiveCookieName } from '@sanity/preview-url-secret/constants';

interface Props {
  title: string;
  description?: string;
  /** If false the nav starts solid (forest bg) instead of transparent */
  transparentNav?: boolean;
  /** Nav text adapts to sit on a cream/light background */
  onCream?: boolean;
  /** Marks the active link in the footer nav */
  activePage?: string;
  lang?: Lang;
}

const {
  title,
  description = 'A singular retreat carved into the stone of Catalunya.',
  transparentNav = true,
  onCream = false,
  activePage,
  lang = 'en',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const siteSettings = await client.fetch<SiteSettings>(SITE_SETTINGS_QUERY);
const draftMode = Astro.cookies.has(perspectiveCookieName);
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — La Cueva de Miravet</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {lang === 'en' && <link rel="alternate" hreflang="es" href={`/es${Astro.url.pathname}`} />}
  {lang === 'es' && <link rel="alternate" hreflang="en" href={Astro.url.pathname.replace(/^\/es/, '') || '/'} />}
  <link rel="alternate" hreflang="x-default" href={lang === 'es' ? Astro.url.pathname.replace(/^\/es/, '') || '/' : Astro.url.pathname} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <Nav transparent={transparentNav} onCream={onCream} lang={lang} activePage={activePage} siteSettings={siteSettings} />
  <slot />
  <Footer lang={lang} activePage={activePage} siteSettings={siteSettings} />

  {draftMode && (
    <>
      <SanityVisualEditing client:only="react" />
      <DisableDraftMode client:only="react" />
    </>
  )}

  <!-- Motion animations -->
  <script>
    import { inView, animate, stagger } from 'motion';

    // Individual scroll-in elements
    inView('[data-animate]', (target) => {
      animate(
        target,
        { opacity: [0, 1], y: [24, 0] },
        { duration: 0.7, easing: [0.22, 0.61, 0.36, 1] }
      );
    }, { amount: 0.12 });

    // Staggered grids — add data-stagger to any grid container
    inView('[data-stagger]', (target) => {
      const children = Array.from(target.children) as HTMLElement[];
      if (children.length === 0) return;
      animate(
        children,
        { opacity: [0, 1], y: [32, 0] },
        { duration: 0.6, delay: stagger(0.1, { start: 0.05 }), easing: [0.22, 0.61, 0.36, 1] }
      );
    }, { amount: 0.1 });
  </script>
</body>
</html>
