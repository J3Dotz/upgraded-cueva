---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { client } from '../../lib/sanity';
import { HOMEPAGE_QUERY, ALL_ROOMS_QUERY } from '../../lib/sanity/queries';
import type { Homepage, RoomListItem } from '../../types/sanity';
import { prefix } from '../../i18n/utils';

const lang = 'es';
const p    = prefix(lang);
const [homepage, rooms] = await Promise.all([
  client.fetch<Homepage>(HOMEPAGE_QUERY),
  client.fetch<RoomListItem[]>(ALL_ROOMS_QUERY, { locale: lang }),
]);

const swatches: Record<string, string> = { olivo:'#5C4838', lavanda:'#8FA59A', laurel:'#B8A48A', tomillo:'#7E6E58', almendro:'#6F8366', roble:'#9A8A74', hinojo:'#4A3F35' };

const wireframeRooms: RoomListItem[] = [
  { _id: 'wf-1', slug: { current: 'olivo'    }, name: 'Olivo',    subtitle: 'Suite Olivo',    tagline: 'Excavado en la roca natural. 16°C constantes.', pricePerNight: 420, imageUrl: null, imageAlt: null },
  { _id: 'wf-2', slug: { current: 'lavanda'  }, name: 'Lavanda',  subtitle: 'Suite Lavanda',  tagline: 'Terraza privada con vistas al mar y bañera exterior.', pricePerNight: 380, imageUrl: null, imageAlt: null },
  { _id: 'wf-3', slug: { current: 'almendro' }, name: 'Almendro', subtitle: 'Suite Almendro', tagline: 'Abre directamente al jardín de hierbas amurallado.', pricePerNight: 290, imageUrl: null, imageAlt: null },
];
---

<Base
  title="Inicio — La Cueva de Miravet"
  description="Una masía restaurada del siglo XIX y una cueva natural en la cima de una montaña en Cabanes, Castellón. Siete habitaciones. Fuera de la red. Vistas al mar."
  lang={lang}
>

  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="hero__inner" data-animate>
      <p class="label hero__label">Cabanes · Castellón · España</p>
      <h1>
        Lujo sostenible
        <span class="italic">en las montañas valencianas.</span>
      </h1>
      <p class="hero__body">Una masía del siglo XIX. Una cueva natural. Siete habitaciones donde la montaña se encuentra con el Mediterráneo.</p>
    </div>
    <form class="availability" data-animate action={`${p}/book`} method="get">
      <div class="availability__field">
        <label for="checkin">Llegada</label>
        <input type="date" id="checkin" name="checkin" />
      </div>
      <span class="availability__sep">·</span>
      <div class="availability__field">
        <label for="checkout">Salida</label>
        <input type="date" id="checkout" name="checkout" />
      </div>
      <span class="availability__sep">·</span>
      <div class="availability__field">
        <label for="guests">Huéspedes</label>
        <select id="guests" name="guests">
          <option>1</option><option selected>2</option><option>3</option>
          <option>4</option><option>5</option><option>6</option>
        </select>
      </div>
      <button type="submit" class="availability__btn">Comprobar disponibilidad</button>
    </form>
    <div class="scroll-indicator" aria-hidden="true"></div>
  </section>

  <!-- ===== Lodge intro ===== -->
  <section class="intro">
    <div class="intro__grid" data-animate>
      <div class="arch-img intro__img-left" role="img" aria-label="La masía al atardecer"></div>
      <div class="intro__center">
        <p class="label">La Propiedad</p>
        <h2>Una masía que<br/>lo recuerda todo.</h2>
        <p>Construida en el siglo XIX, restaurada sin complejos. La Cueva de Miravet se asienta en la cima de una montaña en Cabanes — fuera de la red eléctrica, tranquila, y junto a una cueva natural que lleva aquí mucho más tiempo que nosotros.</p>
        <div class="review-badge">
          <span class="stars">8.7</span>
          <span class="dot"></span>
          <span>Booking.com</span>
          <span class="exceptional">"Excepcional"</span>
        </div>
      </div>
      <div class="arch-img intro__img-right" role="img" aria-label="La cueva natural en los límites de la propiedad"></div>
    </div>
  </section>

  <!-- ===== Amenities ===== -->
  <section class="amenities">
    <div class="amenities__header" data-animate>
      <p class="label">La Propiedad</p>
      <h2>Lo que ofrece la montaña.</h2>
    </div>
    <div class="amenities__grid" data-stagger>
      <div class="amenity"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 28 V16 a10 10 0 0 1 20 0 V28"/><path d="M12 28 V20 a4 4 0 0 1 8 0 V28"/><path d="M2 28 H30"/></svg><span class="amenity__label">Acceso a la cueva</span></div>
      <div class="amenity"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 13 q4 -4 8 0 t8 0 t8 0 t4 0"/><path d="M2 21 q4 -4 8 0 t8 0 t8 0 t4 0"/></svg><span class="amenity__label">Piscina</span></div>
      <div class="amenity"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="22" r="7"/><path d="M10 9 q1.5 -2 3 0 t3 0"/><path d="M16 9 q1.5 -2 3 0 t3 0"/></svg><span class="amenity__label">Jacuzzi panorámico</span></div>
      <div class="amenity"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="6"/><path d="M16 4 V8"/><path d="M16 24 V28"/><path d="M4 16 H8"/><path d="M24 16 H28"/></svg><span class="amenity__label">Solar &amp; autosuficiente</span></div>
      <div class="amenity"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4 H23 V28 H9 Z"/><circle cx="20" cy="17" r="1"/></svg><span class="amenity__label">7 habitaciones</span></div>
      <div class="amenity"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 22 H29"/><path d="M3 26 H29"/><path d="M6 22 Q16 8 26 22"/></svg><span class="amenity__label">Terraza de montaña</span></div>
    </div>
  </section>

  <!-- ===== Reviews marquee ===== -->
  <section class="reviews" aria-label="Opiniones de huéspedes">
    <div class="marquee">
      <div class="marquee__set">
        <div class="review"><p class="review__text">"Vinimos un fin de semana. Hablamos de ello durante un año."</p><p class="review__attr">Maria K. · Países Bajos</p></div>
        <span class="marquee__sep">·</span>
        <div class="review"><p class="review__text">"No hay wifi lo suficientemente bueno para que quieras irte."</p><p class="review__attr">James T. · Reino Unido</p></div>
        <span class="marquee__sep">·</span>
        <div class="review"><p class="review__text">"La cueva al amanecer. No tenemos palabras para describirlo."</p><p class="review__attr">Sophie M. · Alemania</p></div>
        <span class="marquee__sep">·</span>
        <div class="review"><p class="review__text">"La Cueva se queda contigo."</p><p class="review__attr">Carlos V. · España</p></div>
        <span class="marquee__sep">·</span>
      </div>
      <div class="marquee__set" aria-hidden="true">
        <div class="review"><p class="review__text">"Vinimos un fin de semana. Hablamos de ello durante un año."</p><p class="review__attr">Maria K. · Países Bajos</p></div>
        <span class="marquee__sep">·</span>
        <div class="review"><p class="review__text">"No hay wifi lo suficientemente bueno para que quieras irte."</p><p class="review__attr">James T. · Reino Unido</p></div>
        <span class="marquee__sep">·</span>
        <div class="review"><p class="review__text">"La cueva al amanecer. No tenemos palabras para describirlo."</p><p class="review__attr">Sophie M. · Alemania</p></div>
        <span class="marquee__sep">·</span>
        <div class="review"><p class="review__text">"La Cueva se queda contigo."</p><p class="review__attr">Carlos V. · España</p></div>
        <span class="marquee__sep">·</span>
      </div>
    </div>
  </section>

  <!-- ===== Rooms preview ===== -->
  <section class="rooms-section" id="rooms">
    <div class="rooms__header" data-animate>
      <p class="label">Dónde dormir</p>
      <h2>Siete habitaciones. Cada una su propio mundo.</h2>
      <p class="body-sm">Cada habitación abre hacia algo — una terraza, una vista, una calidad particular del silencio.</p>
    </div>
    <div class="rooms__grid" data-stagger>
      {(rooms.length > 0 ? rooms.slice(0, 3) : wireframeRooms).map((r) => {
        const slug  = r.slug?.current ?? '';
        const color = swatches[slug] ?? '#9A8A74';
        return (
          <article class="room-card">
            <a href={`${p}/stay/${slug}`} class="room-card__img-wrap">
              {r.imageUrl
                ? <img src={r.imageUrl} alt={r.imageAlt ?? r.name ?? slug} loading="lazy" class="room-card__img-photo" />
                : <div class="room-card__img" style={`background-color: ${color};`}></div>
              }
            </a>
            <div class="room-card__body">
              <p class="room-card__type">{r.subtitle ?? ''}</p>
              <h3 class="room-card__name">{r.name ?? slug}</h3>
              <div class="room-card__divider"></div>
              <div class="room-card__row">
                <p class="room-card__price">Desde <strong>€{r.pricePerNight ?? '—'}</strong><span class="per">/ noche</span></p>
                <a href={`${p}/stay/${slug}`} class="room-card__cta">Ver habitación</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <div class="rooms__cta" data-animate>
      <a href={`${p}/stay`} class="pill-btn">Ver todas las habitaciones</a>
    </div>
  </section>

  <!-- ===== Activities ===== -->
  <section class="activities">
    <div class="activities__header" data-animate>
      <div class="inner">
        <p class="label">Lo que haces</p>
        <h2>La montaña tiene más que ofrecer que la vista.</h2>
      </div>
    </div>
    <div class="activities__grid" data-stagger>
      <a href={`${p}/experiences`} class="activity"><div class="activity__img-wrap"><div class="activity__img" style="background-color: #6B5B4A;"></div></div><div class="activity__label"><p class="activity__name">Exploración de la cueva</p><p class="activity__desc">Acceso guiado a la cueva natural en los terrenos de la propiedad.</p><span class="activity__arrow">→</span></div></a>
      <a href={`${p}/experiences`} class="activity"><div class="activity__img-wrap"><div class="activity__img" style="background-color: #4A5E45;"></div></div><div class="activity__label"><p class="activity__name">Cata de vino y aceite</p><p class="activity__desc">Productores locales de los valles bajo Cabanes.</p><span class="activity__arrow">→</span></div></a>
      <a href={`${p}/experiences`} class="activity"><div class="activity__img-wrap"><div class="activity__img" style="background-color: #8A7A65;"></div></div><div class="activity__label"><p class="activity__name">Senderismo Desert de les Palmes</p><p class="activity__desc">Un parque natural en el límite de la finca.</p><span class="activity__arrow">→</span></div></a>
    </div>
    <div class="activities__bottom" data-animate>
      <a href={`${p}/experiences`}>Explorar todas las experiencias →</a>
    </div>
  </section>

</Base>

<style>
.label { font-family: var(--font-sans); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; color: var(--stone-mid); }
.body-sm { font-size: 14px; line-height: 1.65; color: var(--stone-mid); }
.italic { font-style: italic; }

.hero { position: relative; height: 100vh; min-height: 720px; background-color: #3A3228; background-image: var(--grain); background-blend-mode: multiply; overflow: hidden; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 0 40px; color: var(--white); }
.hero::before { content: ""; position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(255,255,255,0.03) 0%, transparent 60%); pointer-events: none; }
.hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(58,50,40,0.4) 0%, rgba(58,50,40,0) 30%, rgba(58,50,40,0) 70%, rgba(58,50,40,0.6) 100%); pointer-events: none; }
.hero__inner { position: relative; z-index: 2; text-align: center; max-width: 900px; margin-top: -40px; }
.hero__label { color: rgba(255,255,255,0.7); margin-bottom: 28px; }
.hero h1 { font-family: var(--font-serif); font-size: 72px; font-weight: 300; letter-spacing: -0.02em; line-height: 1.05; color: var(--white); margin-bottom: 32px; }
.hero h1 .italic { display: block; }
.hero__body { max-width: 520px; margin: 0 auto; color: rgba(255,255,255,0.8); font-size: 16px; line-height: 1.75; }

.availability { position: relative; z-index: 2; margin-top: 72px; display: inline-flex; align-items: center; background: rgba(255,255,255,0.10); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.15); border-radius: 100px; padding: 10px 10px 10px 28px; }
.availability__field { display: flex; align-items: center; gap: 8px; color: var(--white); font-family: var(--font-sans); font-size: 13px; }
.availability__field label { color: rgba(255,255,255,0.6); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; }
.availability__field input, .availability__field select { background: transparent; border: none; color: var(--white); font-family: var(--font-sans); font-size: 13px; padding: 6px 4px; outline: none; color-scheme: dark; min-width: 100px; }
.availability__field select option { color: var(--stone-dark); }
.availability__sep { color: rgba(255,255,255,0.3); margin: 0 14px; }
.availability__btn { background: var(--terra); color: var(--white); border-radius: 100px; padding: 12px 28px; font-family: var(--font-sans); font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; margin-left: 18px; border: none; cursor: pointer; transition: background 0.2s ease; }
.availability__btn:hover { background: #b1561f; }

.scroll-indicator { position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); width: 1px; height: 40px; background: rgba(255,255,255,0.3); z-index: 2; overflow: hidden; }
.scroll-indicator::after { content: ""; position: absolute; top: -8px; left: 50%; transform: translateX(-50%); width: 4px; height: 8px; background: var(--white); border-radius: 2px; animation: scrollDown 2.2s ease-in-out infinite; }
@keyframes scrollDown { 0% { top: -8px; opacity: 0; } 25% { opacity: 1; } 75% { opacity: 1; } 100% { top: 40px; opacity: 0; } }

.intro { background: var(--cream); padding: 140px 40px; overflow: hidden; }
.intro__grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 25% 50% 25%; align-items: start; }
.arch-img { width: 100%; background-image: var(--grain); background-blend-mode: multiply; background-size: cover; background-position: center; position: relative; }
.arch-img::before { content: ""; position: absolute; inset: 0; border-radius: inherit; background: linear-gradient(180deg, rgba(0,0,0,0) 60%, rgba(0,0,0,0.18) 100%); }
.intro__img-left { border-radius: 200px 200px 0 0; height: 480px; background-color: #C4A882; }
.intro__img-right { border-radius: 200px 200px 0 0; height: 380px; background-color: #8A9A7A; margin-top: 80px; }
.intro__center { text-align: center; padding: 32px 40px 0; display: flex; flex-direction: column; align-items: center; gap: 20px; }
.intro__center h2 { font-family: var(--font-serif); font-size: 44px; font-weight: 300; }
.intro__center p { max-width: 420px; color: var(--stone-dark); }
.review-badge { display: inline-flex; align-items: center; gap: 10px; background: var(--olive); color: var(--white); border-radius: 100px; padding: 8px 20px; font-family: var(--font-sans); font-size: 12px; font-weight: 500; }
.review-badge .dot { width: 3px; height: 3px; border-radius: 50%; background: rgba(255,255,255,0.5); display: inline-block; }
.review-badge .exceptional { font-family: var(--font-serif); font-style: italic; font-size: 14px; font-weight: 400; }

.amenities { background: var(--cream-deep); padding: 80px 40px; }
.amenities__header { text-align: center; margin-bottom: 56px; }
.amenities__header .label { margin-bottom: 18px; }
.amenities__header h2 { font-family: var(--font-serif); font-size: 44px; font-weight: 300; }
.amenities__grid { max-width: 800px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: var(--cream-deep); }
.amenity { background: var(--white); padding: 40px 24px; text-align: center; color: var(--stone-dark); display: flex; flex-direction: column; align-items: center; transition: background 0.2s ease, color 0.2s ease; }
.amenity:hover { background: var(--cream); color: var(--terra); }
.amenity svg { width: 32px; height: 32px; margin-bottom: 16px; }
.amenity__label { font-family: var(--font-sans); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--stone-mid); transition: color 0.2s ease; }
.amenity:hover .amenity__label { color: var(--terra); }

.reviews { background: var(--forest); padding: 32px 0; overflow: hidden; }
.marquee { display: flex; width: max-content; animation: marquee 40s linear infinite; }
.reviews:hover .marquee { animation-play-state: paused; }
@keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.marquee__set { display: flex; align-items: center; flex-shrink: 0; }
.review { padding: 0 60px; white-space: nowrap; text-align: center; }
.review__text { font-family: var(--font-serif); font-style: italic; font-size: 20px; font-weight: 300; color: var(--white); margin-bottom: 6px; }
.review__attr { font-family: var(--font-sans); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.5); }
.marquee__sep { color: var(--terra); font-size: 24px; align-self: center; }

.rooms-section { background: var(--cream); padding: 140px 40px; }
.rooms__header { text-align: center; max-width: 560px; margin: 0 auto 64px; }
.rooms__header .label { margin-bottom: 18px; }
.rooms__header h2 { font-family: var(--font-serif); font-size: 44px; font-weight: 300; margin-bottom: 20px; }
.rooms__grid { max-width: 960px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.rooms__cta { text-align: center; margin-top: 64px; }

.room-card { display: flex; flex-direction: column; }
.room-card__img-wrap { display: block; overflow: hidden; border-radius: 160px 160px 0 0; }
.room-card__img { width: 100%; height: 320px; background-image: var(--grain); background-blend-mode: multiply; transition: transform 0.6s ease; }
.room-card:hover .room-card__img { transform: scale(1.04); }
.room-card__body { padding: 24px 8px; }
.room-card__type { font-family: var(--font-sans); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; color: var(--terra); margin-bottom: 10px; }
.room-card__name { font-family: var(--font-serif); font-size: 28px; font-weight: 300; color: var(--stone-dark); }
.room-card__divider { height: 1px; background: var(--stone-light); margin: 16px 0 12px; }
.room-card__row { display: flex; align-items: baseline; justify-content: space-between; }
.room-card__price { font-size: 13px; color: var(--stone-mid); }
.room-card__price strong { font-family: var(--font-serif); font-style: italic; font-size: 20px; color: var(--stone-dark); margin: 0 4px; }
.room-card__price .per { font-size: 12px; color: var(--stone-mid); }
.room-card__cta { font-family: var(--font-sans); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--terra); }
.pill-btn { display: inline-block; border: 1px solid var(--terra); color: var(--terra); background: transparent; border-radius: 100px; padding: 14px 36px; font-family: var(--font-sans); font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; transition: background 0.25s ease, color 0.25s ease; }
.pill-btn:hover { background: var(--terra); color: var(--white); }

.activities { background: var(--cream); padding: 80px 40px; border-top: 1px solid var(--stone-light); }
.activities__header { max-width: 1200px; margin: 0 auto 48px; }
.activities__header .inner { max-width: 480px; }
.activities__header .label { margin-bottom: 18px; }
.activities__header h2 { font-family: var(--font-serif); font-size: 44px; font-weight: 300; }
.activities__grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; }
.activity { background: var(--cream); cursor: pointer; }
.activity__img-wrap { overflow: hidden; aspect-ratio: 3/4; border-radius: 200px 200px 0 0; }
.activity__img { width: 100%; height: 100%; background-image: var(--grain); background-blend-mode: multiply; transition: transform 0.4s ease; }
.activity:hover .activity__img { transform: scale(1.03); }
.activity__label { background: var(--cream); padding: 20px 4px; }
.activity__name { font-family: var(--font-serif); font-size: 22px; font-weight: 400; color: var(--stone-dark); margin-bottom: 4px; transition: color 0.2s; }
.activity:hover .activity__name { color: var(--terra); }
.activity__desc { font-size: 13px; color: var(--stone-mid); }
.activity__arrow { color: var(--terra); font-size: 18px; margin-top: 8px; display: inline-block; transition: transform 0.2s; }
.activity:hover .activity__arrow { transform: translateX(4px); }
.activities__bottom { text-align: center; margin-top: 48px; }
.activities__bottom a { font-size: 13px; font-weight: 500; color: var(--terra); text-transform: uppercase; letter-spacing: 0.08em; }

@media (max-width: 1024px) {
  .hero h1 { font-size: 56px; }
  .intro__grid { grid-template-columns: 1fr; gap: 40px; }
  .intro__img-left, .intro__img-right { max-width: 360px; margin: 0 auto; height: 360px; }
  .rooms__grid { grid-template-columns: repeat(2, 1fr); }
  .activities__grid { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
  .hero { padding: 0 24px; min-height: 640px; }
  .hero h1 { font-size: 44px; }
  .availability { flex-direction: column; border-radius: 28px; padding: 16px; width: 100%; max-width: 360px; align-items: stretch; gap: 8px; margin-top: 40px; }
  .availability__sep { display: none; }
  .availability__field { padding: 10px 14px; background: rgba(255,255,255,0.05); border-radius: 16px; }
  .availability__btn { margin-left: 0; width: 100%; }
  .intro { padding: 80px 24px; }
  .amenities { padding-left: 24px; padding-right: 24px; }
  .amenities__grid { grid-template-columns: repeat(2, 1fr); }
  .rooms-section { padding: 80px 24px; }
  .rooms__grid { grid-template-columns: 1fr; max-width: 360px; }
  .activities { padding-left: 24px; padding-right: 24px; }
}
</style>
