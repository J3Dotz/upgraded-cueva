---
export const prerender = true;
import Base from '../../../layouts/Base.astro';
import { client } from '../../../lib/sanity';
import { JOURNAL_POSTS_QUERY } from '../../../lib/sanity/queries';
import type { JournalPostListItem } from '../../../types/sanity';
import { formatDate, useTranslations } from '../../../i18n/utils';

const lang  = 'es';
const t     = useTranslations(lang);
const posts = await client.fetch<JournalPostListItem[]>(JOURNAL_POSTS_QUERY, { locale: lang });
const featured = posts.find(p => p.featured) ?? posts[0] ?? null;
const archive  = posts.filter(p => p !== featured);
---

<Base
  title="Diario"
  description="Notas sobre la tierra, las estaciones y las cosas extraordinariamente silenciosas que suceden aquí."
  onCream={true}
  activePage="journal"
  lang={lang}
>

  {featured && (
    <section class="featured">
      {featured.featuredImageUrl && (
        <div class="featured__img-wrap">
          <img src={featured.featuredImageUrl} alt={featured.title ?? ''} loading="eager" />
        </div>
      )}
      <div class="featured__body">
        <p class="featured__label">{t('journal.hero.title')}</p>
        <h1 class="featured__title">{featured.title}</h1>
        {featured.excerpt && <p class="featured__excerpt">{featured.excerpt}</p>}
        <a href={`/es/diario/${featured.slug.current}`} class="terra-link">{t('journal.read')}</a>
      </div>
    </section>
  )}

  {archive.length > 0 && (
    <section class="archive">
      <div class="archive__inner">
        <div class="archive__grid">
          {archive.map((post) => (
              <article class="article-card" data-animate>
                {post.featuredImageUrl && (
                  <a href={`/es/diario/${post.slug.current}`} class="article-card__img">
                    <img src={post.featuredImageUrl} alt={post.title ?? ''} loading="lazy" />
                  </a>
                )}
                <div class="article-card__body">
                  <h3><a href={`/es/diario/${post.slug.current}`}>{post.title}</a></h3>
                  <span class="article-card__date">{formatDate(post.publishedAt, lang)}</span>
                  <a href={`/es/diario/${post.slug.current}`} class="terra-link">{t('journal.read')}</a>
                </div>
              </article>
            ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
.featured { display: grid; grid-template-columns: 1fr 1fr; min-height: 70vh; }
.featured__img-wrap { overflow: hidden; }
.featured__img-wrap img { width: 100%; height: 100%; object-fit: cover; }
.featured__body { background: var(--cream-deep); padding: 120px 60px 80px; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
.featured__label { font-family: var(--font-sans); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--terra); }
.featured__title { font-size: 48px; font-weight: 300; }
.featured__excerpt { font-size: 15px; color: var(--stone-mid); line-height: 1.7; }
.archive { padding: 80px 40px 120px; }
.archive__inner { max-width: 1200px; margin: 0 auto; }
.archive__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 32px; }
.article-card { display: flex; flex-direction: column; gap: 12px; }
.article-card__img { display: block; overflow: hidden; border-radius: 2px; }
.article-card__img img { width: 100%; aspect-ratio: 3/2; object-fit: cover; transition: transform 0.5s var(--ease); }
.article-card:hover .article-card__img img { transform: scale(1.03); }
.article-card__body { display: flex; flex-direction: column; gap: 8px; }
.article-card h3 { font-size: 22px; }
.article-card__date { font-size: 11px; color: var(--stone-light); }
@media (max-width: 768px) {
  .featured { grid-template-columns: 1fr; }
  .featured__body { padding: 60px 24px; }
  .featured__title { font-size: 36px; }
  .archive { padding: 60px 24px 80px; }
  .archive__grid { grid-template-columns: 1fr; }
}
</style>
