---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { client, urlFor } from '../../lib/sanity';
import { experiencesQuery } from '../../queries/experiences';
import { loc, useTranslations } from '../../i18n/utils';

const lang        = 'es';
const t           = useTranslations(lang);
const experiences = await client.fetch(experiencesQuery);
---

<Base
  title="Experiencias"
  description="Rutas guiadas, cosecha de aceitunas, escalada, astronomía — actividades lentas para mentes abiertas."
  activePage="experiences"
  lang={lang}
>
  <section class="page-hero">
    <div class="page-hero__inner">
      <p class="page-hero__label">Experiencias</p>
      <h1 class="page-hero__title">{t('exp.hero.title')}</h1>
    </div>
  </section>

  <section class="exp-grid">
    <div class="exp-grid__inner">
      {experiences.map((exp: any) => {
        const imgSrc = exp.image
          ? urlFor(exp.image).width(720).height(540).auto('format').url()
          : null;
        return (
          <article class="exp-card" data-animate>
            {imgSrc && (
              <div class="exp-card__img">
                <img src={imgSrc} alt={exp.image?.alt ?? loc(exp.title, lang)} loading="lazy" />
              </div>
            )}
            <div class="exp-card__body">
              {exp.category && <p class="exp-card__tag">{exp.category}</p>}
              <h3 class="exp-card__title">{loc(exp.title, lang)}</h3>
              {exp.description && <p class="exp-card__desc">{loc(exp.description, lang)}</p>}
              <a href="/es/reservar" class="terra-link">{t('exp.enquire')}</a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Base>

<style>
.page-hero { background: var(--stone-dark); padding: 160px 40px 80px; }
.page-hero__inner { max-width: 800px; margin: 0 auto; }
.page-hero__label { font-family: var(--font-sans); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--terra); margin-bottom: 16px; }
.page-hero__title { font-family: var(--font-serif); font-size: 72px; font-weight: 300; color: var(--white); }
.exp-grid { padding: 80px 40px 120px; }
.exp-grid__inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, 1fr); gap: 48px 40px; }
.exp-card { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
.exp-card__img { overflow: hidden; border-radius: 2px; }
.exp-card__img img { width: 100%; aspect-ratio: 4/3; object-fit: cover; transition: transform 0.6s var(--ease); }
.exp-card:hover .exp-card__img img { transform: scale(1.03); }
.exp-card__body { display: flex; flex-direction: column; gap: 10px; }
.exp-card__tag { font-family: var(--font-sans); font-size: 10px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--terra); }
.exp-card__title { font-family: var(--font-serif); font-size: 28px; }
.exp-card__desc { font-size: 14px; color: var(--stone-mid); line-height: 1.7; }
@media (max-width: 768px) {
  .page-hero { padding: 130px 24px 60px; }
  .page-hero__title { font-size: 48px; }
  .exp-grid { padding: 60px 24px 80px; }
  .exp-grid__inner { grid-template-columns: 1fr; }
  .exp-card { grid-template-columns: 1fr; }
}
</style>
