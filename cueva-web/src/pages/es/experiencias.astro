---
// /es/experiencias is redirected to /es/experiences via astro.config.mjs redirects.
// This file is a safety fallback — the config redirect wins at the CDN level.
export const prerender = true;
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/es/experiences" />
    <link rel="canonical" href="/es/experiences" />
    <title>Redirigiendo…</title>
  </head>
  <body>
    <script>window.location.replace('/es/experiences');</script>
  </body>
</html>
