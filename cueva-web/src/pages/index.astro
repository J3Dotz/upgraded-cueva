---
export const prerender = true;
import Base from '../layouts/Base.astro';
import HeroSection from '../components/layout/HeroSection.astro';
import RoomCard from '../components/RoomCard.astro';
import { client } from '../lib/sanity';
import { HOMEPAGE_QUERY, ALL_ROOMS_QUERY } from '../lib/sanity/queries';
import type { Homepage, RoomListItem } from '../types/sanity';

const lang = 'en';

const [homepage, rooms] = await Promise.all([
  client.fetch<Homepage>(HOMEPAGE_QUERY),
  client.fetch<RoomListItem[]>(ALL_ROOMS_QUERY, { locale: lang }),
]);

const hero               = homepage?.hero;
const lodge              = homepage?.lodge;
const propertyFeatures   = homepage?.propertyFeatures;
const testimonials       = homepage?.testimonials ?? [];
const roomsTeaser        = homepage?.roomsTeaser;
const experiencesTeaser  = homepage?.experiencesTeaser;
const closingQuote       = homepage?.closingQuote;

// Hero media
const heroImgUrl    = hero?.heroImage?.url   ?? null;
const heroVideoUrl  = hero?.heroVideoUrl     ?? null;
const heroPosterUrl = hero?.heroVideoPoster?.url ?? heroImgUrl;
const showVideo     = hero?.mediaType === 'video' && heroVideoUrl;
const showImage     = hero?.mediaType === 'image' && heroImgUrl;

// Wireframe fallback rooms (shown if Sanity returns no rooms yet)
const wireframeRooms = [
  { slug: { current: 'olivo'    }, name: 'Olivo',    subtitle: 'Olive Suite',     tagline: 'Carved into the natural rock face.', pricePerNight: 420, imageUrl: null, imageAlt: null, _id: 'wf-1' },
  { slug: { current: 'lavanda'  }, name: 'Lavanda',  subtitle: 'Lavender Suite',  tagline: 'Private sea-view terrace with day bed.', pricePerNight: 380, imageUrl: null, imageAlt: null, _id: 'wf-2' },
  { slug: { current: 'laurel'   }, name: 'Laurel',   subtitle: 'Bay Laurel Suite', tagline: 'Floor-to-ceiling windows facing south.', pricePerNight: 340, imageUrl: null, imageAlt: null, _id: 'wf-3' },
] as RoomListItem[];
const displayRooms = rooms.length > 0 ? rooms.slice(0, 3) : wireframeRooms;

// Icon map for property features
const featureColors: Record<string, string> = {
  cave: '#5C4838', pool: '#4A5E45', 'hot-tub': '#8A7A65',
  solar: '#9A8A74', rooms: '#7E6E58', terrace: '#6F8366',
};

// Fallback amenities shown when Sanity propertyFeatures is empty
const fallbackAmenities = [
  { icon: 'cave',    label: 'Cave Access'       },
  { icon: 'pool',    label: 'Swimming Pool'      },
  { icon: 'hot-tub', label: 'Panoramic Hot Tub'  },
  { icon: 'solar',   label: 'Off-Grid & Solar'   },
  { icon: 'rooms',   label: '7 Rooms'            },
  { icon: 'terrace', label: 'Mountain Terrace'   },
];
const amenities = propertyFeatures?.features?.length
  ? propertyFeatures.features
  : fallbackAmenities;

// Fallback activities shown when Sanity experiencesTeaser is empty
const fallbackActivities = [
  { title: 'Cave Exploration',               description: 'Guided access into the natural cave on the property grounds.', href: '/experiences', color: '#6B5B4A' },
  { title: 'Wine & Olive Tasting',           description: 'Local producers from the valleys below Cabanes.',               href: '/experiences', color: '#4A5E45' },
  { title: 'Hiking Desert de les Palmes',    description: 'A national park at the edge of the estate.',                    href: '/experiences', color: '#8A7A65' },
];
const activities = experiencesTeaser?.items?.length
  ? experiencesTeaser.items.map(i => ({ ...i, color: '#8A7A65' }))
  : fallbackActivities;

// Fallback testimonials
const fallbackTestimonials = [
  { quote: 'We came for a weekend. We talked about it for a year.',                              author: 'Maria K.',  country: 'Netherlands' },
  { quote: 'There is no wifi strong enough to make you want to leave.',                          author: 'James T.',  country: 'United Kingdom' },
  { quote: 'The cave at sunrise. We have no words for it.',                                      author: 'Sophie M.', country: 'Germany' },
  { quote: 'Off-grid doesn\'t mean roughing it. It means something completely different here.', author: 'Lena R.',   country: 'France' },
  { quote: 'La Cueva se queda contigo.',                                                         author: 'Carlos V.', country: 'España' },
];
const reviews = testimonials.length > 0 ? testimonials : fallbackTestimonials;
---

<Base
  title="La Cueva de Miravet — Sustainable Luxury Ecolodge, Castellón"
  description="A restored 19th-century Masia and natural cave on a mountaintop in Cabanes, Castellón. Seven rooms. Off-grid. Sea views. The Valencian mountains at their most private."
  lang={lang}
>

  <!-- ===== Hero ===== -->
  <HeroSection
    eyebrow={hero?.eyebrow ?? 'Cabanes · Castellón · Spain'}
    subline={hero?.subline ?? 'A 19th-century Masia. A natural cave. Seven rooms where the mountain meets the Mediterranean.'}
    bgScheme="stone"
    bgImage={showImage ? heroImgUrl ?? undefined : undefined}
    videoUrl={showVideo ? heroVideoUrl ?? undefined : undefined}
    videoPoster={heroPosterUrl ?? undefined}
    mediaType={hero?.mediaType ?? 'colour'}
    overlayStyle="stone"
    size="full"
    textAlign="center"
    contentPosition="center"
  >
    <Fragment slot="headline">
      {hero?.headline ?? <>Sustainable luxury<span class="italic"> in the Valencian mountains.</span></>}
    </Fragment>

    <form class="availability" data-animate action="/book" method="get">
      <div class="availability__field">
        <label for="checkin">Check-in</label>
        <input type="date" id="checkin" name="checkin" />
      </div>
      <span class="availability__sep">·</span>
      <div class="availability__field">
        <label for="checkout">Check-out</label>
        <input type="date" id="checkout" name="checkout" />
      </div>
      <span class="availability__sep">·</span>
      <div class="availability__field">
        <label for="guests">Guests</label>
        <select id="guests" name="guests">
          <option>1</option><option selected>2</option><option>3</option>
          <option>4</option><option>5</option><option>6</option>
        </select>
      </div>
      <button type="submit" class="availability__btn">Check Availability</button>
    </form>

    <div class="scroll-indicator" aria-hidden="true"></div>
  </HeroSection>

  <!-- ===== Intro ===== -->
  <section class="intro">
    <div class="intro__grid" data-animate>
      <div class="arch-img intro__img-left" role="img" aria-label="The Masia at dusk"></div>
      <div class="intro__center">
        <p class="label">{lodge?.sectionLabel ?? 'The Lodge'}</p>
        <h2>{lodge?.headline ?? 'A Masia that remembers everything.'}</h2>
        <p>{lodge?.body ?? 'Built in the 19th century, restored without apology. La Cueva de Miravet sits on a mountaintop in Cabanes — off-grid, unhurried, and beside a natural cave that has been here considerably longer than we have.'}</p>
        <!-- TODO: wire to Sanity — fields: siteSettings.bookingScore, siteSettings.bookingLabel -->
        <div class="review-badge">
          <span class="stars">8.7</span>
          <span class="dot"></span>
          <span>Booking.com</span>
          <span class="exceptional">"Exceptional"</span>
        </div>
      </div>
      <div class="arch-img intro__img-right" role="img" aria-label="The natural cave at the property edge"></div>
    </div>
  </section>

  <!-- ===== Amenities ===== -->
  <section class="amenities">
    <div class="amenities__header" data-animate>
      <p class="label">{propertyFeatures?.sectionLabel ?? 'The Property'}</p>
      <h2>{propertyFeatures?.headline ?? 'What the mountain provides.'}</h2>
    </div>
    <div class="amenities__grid" data-stagger>

      {amenities.map((a) => (
        <div class="amenity">
          {a.icon === 'cave' && (
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 28 V16 a10 10 0 0 1 20 0 V28"/><path d="M12 28 V20 a4 4 0 0 1 8 0 V28"/><path d="M2 28 H30"/>
            </svg>
          )}
          {a.icon === 'pool' && (
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 13 q4 -4 8 0 t8 0 t8 0 t4 0"/><path d="M2 21 q4 -4 8 0 t8 0 t8 0 t4 0"/>
            </svg>
          )}
          {a.icon === 'hot-tub' && (
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="16" cy="22" r="7"/><path d="M10 9 q1.5 -2 3 0 t3 0"/><path d="M16 9 q1.5 -2 3 0 t3 0"/><path d="M13 5 q1 -1.5 2 0"/>
            </svg>
          )}
          {a.icon === 'solar' && (
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="16" cy="16" r="6"/><path d="M16 4 V8"/><path d="M16 24 V28"/><path d="M4 16 H8"/><path d="M24 16 H28"/>
            </svg>
          )}
          {a.icon === 'rooms' && (
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 4 H23 V28 H9 Z"/><circle cx="20" cy="17" r="1"/>
            </svg>
          )}
          {a.icon === 'terrace' && (
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 22 H29"/><path d="M3 26 H29"/><path d="M6 22 Q16 8 26 22"/>
            </svg>
          )}
          {!['cave','pool','hot-tub','solar','rooms','terrace'].includes(a.icon ?? '') && (
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="16" cy="16" r="10"/>
            </svg>
          )}
          <span class="amenity__label">{a.label}</span>
        </div>
      ))}

    </div>
  </section>

  <!-- ===== Reviews Marquee ===== -->
  <section class="reviews" aria-label="Guest reviews">
    <div class="marquee">
      <div class="marquee__set">
        {reviews.map((r) => (
          <>
            <div class="review">
              <p class="review__text">"{r.quote}"</p>
              <p class="review__attr">{r.author}{r.country ? ` · ${r.country}` : ''}</p>
            </div>
            <span class="marquee__sep">·</span>
          </>
        ))}
      </div>
      <div class="marquee__set" aria-hidden="true">
        {reviews.map((r) => (
          <>
            <div class="review">
              <p class="review__text">"{r.quote}"</p>
              <p class="review__attr">{r.author}{r.country ? ` · ${r.country}` : ''}</p>
            </div>
            <span class="marquee__sep">·</span>
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Rooms ===== -->
  <section class="rooms-section" id="rooms">
    <div class="rooms__header" data-animate>
      <p class="label">{roomsTeaser?.sectionLabel ?? 'Where you sleep'}</p>
      <h2>{roomsTeaser?.headline ?? 'Seven rooms. Each one its own world.'}</h2>
      <p class="body-sm">{roomsTeaser?.subline ?? 'Every room opens onto something — a terrace, a view, a particular quality of silence. Book a single room or take the lodge exclusively.'}</p>
    </div>

    <div class="rooms__grid" data-stagger>
      {displayRooms.map((room) => (
        <RoomCard room={room} lang={lang} />
      ))}
    </div>

    <div class="rooms__cta" data-animate>
      <a href="/stay" class="pill-btn">View all rooms</a>
    </div>
  </section>

  <!-- ===== Activities ===== -->
  <section class="activities">
    <div class="activities__header" data-animate>
      <div class="inner">
        <p class="label">{experiencesTeaser?.sectionLabel ?? 'What you do'}</p>
        <h2>{experiencesTeaser?.headline ?? 'The mountain has more to offer than the view.'}</h2>
      </div>
    </div>

    <div class="activities__grid" data-animate>
      {activities.map((act) => (
        <a href={act.href ?? '/experiences'} class="activity">
          <div class="activity__img-wrap">
            <div class="activity__img" style={`background-color: ${act.color};`}></div>
          </div>
          <div class="activity__label">
            <p class="activity__name">{act.title}</p>
            <p class="activity__desc">{act.description}</p>
            <span class="activity__arrow">→</span>
          </div>
        </a>
      ))}
    </div>

    <div class="activities__bottom" data-animate>
      <a href="/experiences">Explore all experiences →</a>
    </div>
  </section>

</Base>

<style>
/* ===== Label utility ===== */
.label {
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--stone-mid);
}
.body-sm { font-size: 14px; line-height: 1.65; color: var(--stone-mid); }

/* Hero styles live in HeroSection.astro */

/* Availability bar */
.availability {
  position: relative; z-index: 2;
  margin-top: 72px;
  display: inline-flex; align-items: center;
  background: rgba(255,255,255,0.10);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 100px;
  padding: 10px 10px 10px 28px;
}
.availability__field {
  display: flex; align-items: center; gap: 8px;
  color: var(--white);
  font-family: var(--font-sans); font-size: 13px;
}
.availability__field label {
  color: rgba(255,255,255,0.6);
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;
}
.availability__field input,
.availability__field select {
  background: transparent; border: none;
  color: var(--white);
  font-family: var(--font-sans); font-size: 13px;
  padding: 6px 4px; outline: none;
  color-scheme: dark; min-width: 110px;
}
.availability__field select option { color: var(--stone-dark); }
.availability__sep { color: rgba(255,255,255,0.3); margin: 0 14px; font-size: 13px; }
.availability__btn {
  background: var(--terra); color: var(--white);
  border-radius: 100px; padding: 12px 28px;
  font-family: var(--font-sans); font-size: 13px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.08em;
  margin-left: 18px; border: none; cursor: pointer;
  transition: background 0.2s ease;
}
.availability__btn:hover { background: #b1561f; }

/* Scroll indicator */
.scroll-indicator {
  position: absolute; bottom: 32px; left: 50%;
  transform: translateX(-50%);
  width: 1px; height: 40px;
  background: rgba(255,255,255,0.3);
  z-index: 2; overflow: hidden;
}
.scroll-indicator::after {
  content: "";
  position: absolute; top: -8px; left: 50%;
  transform: translateX(-50%);
  width: 4px; height: 8px;
  background: var(--white); border-radius: 2px;
  animation: scrollDown 2.2s ease-in-out infinite;
}
@keyframes scrollDown {
  0% { top: -8px; opacity: 0; }
  25% { opacity: 1; }
  75% { opacity: 1; }
  100% { top: 40px; opacity: 0; }
}

/* ===== Intro ===== */
.intro {
  background: var(--cream);
  padding: 140px 40px;
  overflow: hidden;
}
.intro__grid {
  max-width: 1200px; margin: 0 auto;
  display: grid; grid-template-columns: 25% 50% 25%;
  align-items: start;
}
.arch-img {
  width: 100%;
  background-image: var(--grain);
  background-blend-mode: multiply;
  background-size: cover; background-position: center;
  position: relative;
}
.arch-img::before {
  content: "";
  position: absolute; inset: 0; border-radius: inherit;
  background: linear-gradient(180deg, rgba(0,0,0,0) 60%, rgba(0,0,0,0.18) 100%);
}
.intro__img-left {
  border-radius: 200px 200px 0 0;
  height: 480px; background-color: #C4A882;
}
.intro__img-right {
  border-radius: 200px 200px 0 0;
  height: 380px; background-color: #8A9A7A;
  margin-top: 80px;
}
.intro__center {
  text-align: center; padding: 32px 40px 0;
  display: flex; flex-direction: column; align-items: center; gap: 20px;
}
.intro__center h2 { font-size: 44px; font-weight: 300; }
.intro__center p { max-width: 420px; color: var(--stone-dark); text-wrap: pretty; }

.review-badge {
  display: inline-flex; align-items: center; gap: 10px;
  background: var(--olive); color: var(--white);
  border-radius: 100px; padding: 8px 20px;
  font-family: var(--font-sans); font-size: 12px; font-weight: 500;
}
.review-badge .stars { letter-spacing: 0.05em; }
.review-badge .exceptional {
  font-family: var(--font-serif); font-style: italic;
  font-size: 14px; font-weight: 400;
}
.review-badge .dot {
  width: 3px; height: 3px; border-radius: 50%;
  background: rgba(255,255,255,0.5); display: inline-block;
}

/* ===== Amenities ===== */
.amenities {
  background: var(--cream-deep);
  padding: 80px 40px;
}
.amenities__header { text-align: center; margin-bottom: 56px; }
.amenities__header .label { margin-bottom: 18px; }
.amenities__header h2 { font-size: 44px; font-weight: 300; }
.amenities__grid {
  max-width: 800px; margin: 0 auto;
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 2px; background: var(--cream-deep);
}
.amenity {
  background: var(--white); padding: 40px 24px;
  text-align: center; color: var(--stone-dark);
  display: flex; flex-direction: column; align-items: center;
  transition: background 0.2s ease, color 0.2s ease;
}
.amenity:hover { background: var(--cream); color: var(--terra); }
.amenity svg { width: 32px; height: 32px; margin-bottom: 16px; }
.amenity__label {
  font-family: var(--font-sans); font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--stone-mid); transition: color 0.2s ease;
}
.amenity:hover .amenity__label { color: var(--terra); }

/* ===== Reviews marquee ===== */
.reviews {
  background: var(--forest);
  padding: 32px 0; overflow: hidden;
}
.marquee {
  display: flex; width: max-content;
  animation: marquee 40s linear infinite;
}
.reviews:hover .marquee { animation-play-state: paused; }
@keyframes marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
.marquee__set {
  display: flex; align-items: center; flex-shrink: 0;
}
.review {
  padding: 0 60px; white-space: nowrap; text-align: center;
}
.review__text {
  font-family: var(--font-serif); font-style: italic;
  font-size: 20px; font-weight: 300;
  color: var(--white); margin-bottom: 6px;
}
.review__attr {
  font-family: var(--font-sans); font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.1em;
  color: rgba(255,255,255,0.5);
}
.marquee__sep { color: var(--terra); font-size: 24px; align-self: center; }

/* ===== Rooms ===== */
.rooms-section {
  background: var(--cream); padding: 140px 40px;
}
.rooms__header {
  text-align: center; max-width: 560px;
  margin: 0 auto 64px;
}
.rooms__header .label { margin-bottom: 18px; }
.rooms__header h2 { font-size: 44px; font-weight: 300; margin-bottom: 20px; }
.rooms__grid {
  max-width: 960px; margin: 0 auto;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
}
.rooms__cta { text-align: center; margin-top: 64px; }

.pill-btn {
  display: inline-block;
  border: 1px solid var(--terra); color: var(--terra);
  background: transparent; border-radius: 100px;
  padding: 14px 36px;
  font-family: var(--font-sans); font-size: 13px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.08em;
  transition: background 0.25s ease, color 0.25s ease;
}
.pill-btn:hover { background: var(--terra); color: var(--white); }

/* ===== Activities ===== */
.activities {
  background: var(--cream); padding: 80px 40px;
  border-top: 1px solid var(--stone-light);
}
.activities__header { max-width: 1200px; margin: 0 auto 48px; }
.activities__header .inner { max-width: 480px; }
.activities__header .label { margin-bottom: 18px; }
.activities__header h2 { font-size: 44px; font-weight: 300; }
.activities__grid {
  max-width: 1200px; margin: 0 auto;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px;
}
.activity { background: var(--cream); cursor: pointer; }
.activity__img-wrap {
  overflow: hidden; aspect-ratio: 3/4;
  border-radius: 200px 200px 0 0;
}
.activity__img {
  width: 100%; height: 100%;
  background-image: var(--grain);
  background-blend-mode: multiply;
  background-size: cover;
  transition: transform 0.4s ease;
}
.activity:hover .activity__img { transform: scale(1.03); }
.activity__label { background: var(--cream); padding: 20px 4px; }
.activity__name {
  font-family: var(--font-serif); font-size: 22px; font-weight: 400;
  color: var(--stone-dark); transition: color 0.2s ease; margin-bottom: 4px;
}
.activity:hover .activity__name { color: var(--terra); }
.activity__desc { font-size: 13px; color: var(--stone-mid); }
.activity__arrow {
  color: var(--terra); font-size: 18px; margin-top: 8px;
  display: inline-block; transition: transform 0.2s ease;
}
.activity:hover .activity__arrow { transform: translateX(4px); }
.activities__bottom { text-align: center; margin-top: 48px; }
.activities__bottom a {
  font-size: 13px; font-weight: 500;
  color: var(--terra); text-transform: uppercase; letter-spacing: 0.08em;
}
.activities__bottom a:hover { text-decoration: underline; }

/* ===== Responsive ===== */
@media (max-width: 1024px) {
  .intro__grid { grid-template-columns: 1fr; gap: 40px; }
  .intro__img-left, .intro__img-right { max-width: 360px; margin: 0 auto; height: 360px; }
  .rooms__grid { grid-template-columns: repeat(2, 1fr); }
  .activities__grid { grid-template-columns: 1fr; }
}
@media (max-width: 768px) {
  .availability {
    flex-direction: column; border-radius: 28px;
    padding: 16px; width: 100%; max-width: 360px;
    align-items: stretch; gap: 8px; margin-top: 40px;
  }
  .availability__sep { display: none; }
  .availability__field { padding: 10px 14px; background: rgba(255,255,255,0.05); border-radius: 16px; justify-content: space-between; }
  .availability__btn { margin-left: 0; width: 100%; }
  .intro { padding: 80px 24px; }
  .amenities { padding-left: 24px; padding-right: 24px; }
  .amenities__grid { grid-template-columns: repeat(2, 1fr); }
  .rooms-section { padding: 80px 24px; }
  .rooms__grid { grid-template-columns: 1fr; max-width: 360px; }
  .activities { padding-left: 24px; padding-right: 24px; }
}
</style>
