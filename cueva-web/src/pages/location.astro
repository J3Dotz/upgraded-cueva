---
export const prerender = true;
import Base from '../layouts/Base.astro';
import { client } from '../lib/sanity';
import { LOCATION_PAGE_QUERY } from '../lib/sanity/queries';
import type { LocationPage, PortableTextBlock } from '../types/sanity';
import { prefix } from '../i18n/utils';

const lang     = 'en';
const p        = prefix(lang);
const location = await client.fetch<LocationPage>(LOCATION_PAGE_QUERY);
---

<Base
  title="Location — La Cueva de Miravet"
  description="How to arrive at La Cueva de Miravet — a 19th-century Masia on a mountaintop in Cabanes, Castellón. By road, rail or air. With the correct directions (because Google Maps gets it wrong)."
  activePage="location"
  lang={lang}
>

  <!-- ===== Hero ===== -->
  <section class="hero">
    <div class="hero__topo" aria-hidden="true">
      <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" fill="none" stroke="rgba(196,98,45,0.18)" stroke-width="1">
        <path d="M-40 600 Q 200 540 480 580 T 1000 540 T 1640 580"/>
        <path d="M-40 560 Q 220 500 500 540 T 1020 500 T 1640 540"/>
        <path d="M-40 520 Q 240 460 520 500 T 1040 460 T 1640 500"/>
        <path d="M-40 480 Q 260 420 540 460 T 1060 420 T 1640 460"/>
        <path d="M-40 440 Q 280 380 560 420 T 1080 380 T 1640 420"/>
        <path d="M-40 400 Q 300 340 580 380 T 1100 340 T 1640 380"/>
        <path d="M-40 360 Q 320 300 600 340 T 1120 300 T 1640 340"/>
        <path d="M-40 320 Q 340 260 620 300 T 1140 260 T 1640 300"/>
        <path d="M-40 280 Q 360 220 640 260 T 1160 220 T 1640 260"/>
        <path d="M-40 240 Q 380 180 660 220 T 1180 180 T 1640 220"/>
      </svg>
    </div>

    <div class="hero__inner">
      <div data-animate>
        <div class="label hero__label">
          <span class="pip"></span>
          <!-- TODO: wire to Sanity — field: locationPage.subline -->
          <span>{location?.subline ?? 'The Lodge · Cabanes · Castellón'}</span>
        </div>
        <h1>
          {location?.headline ?? <>Find us.<br/><span class="italic">We'll wait.</span></>}
        </h1>
      </div>

      <div class="hero__coords" data-animate>
        <div class="label-row">
          <span class="rule"></span>
          <span>Coordinates</span>
        </div>
        <div class="value">40°07'09.5"N &nbsp; 0°04'47.8"E</div>
        <div class="label-row" style="margin-top: 18px;">
          <span class="rule"></span>
          <span>Elevation</span>
        </div>
        <div class="elev"><strong>412 m</strong> above the Mediterranean</div>
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true">
      <span>Scroll</span>
      <span class="line"></span>
    </div>
  </section>

  <!-- ===== Address + Map ===== -->
  <section class="address">
    <div class="address__grid">
      <div class="address__left" data-animate>
        <span class="label">The Address</span>
        <h2>End of the road.<br/><span class="italic">Then a little further.</span></h2>

        <p class="address__addr">
          La Cueva de Miravet<br/>
          La Ferradura, Cabanes<br/>
          Castellón, Spain — 12595
        </p>
        <p class="address__addr-sub">40°07'09.5"N · 0°04'47.8"E</p>

        <div class="address__stats">
          <div class="address__stat">
            <span class="k">Nearest park</span>
            <span class="v">15 min<small>Desert de les Palmes</small></span>
          </div>
          <div class="address__stat">
            <span class="k">Valencia</span>
            <span class="v">1 h 15<small>By car, CV-10</small></span>
          </div>
          <div class="address__stat">
            <span class="k">Barcelona</span>
            <span class="v">3 hrs<small>By car</small></span>
          </div>
          <div class="address__stat">
            <span class="k">Oropesa del Mar</span>
            <span class="v">20 min<small>Nearest train station</small></span>
          </div>
        </div>

        <div class="notice">
          <div class="heading">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 2 L14.5 13 L1.5 13 Z"/>
              <path d="M8 6.5 V9.5"/>
              <circle cx="8" cy="11.4" r="0.6" fill="currentColor"/>
            </svg>
            A note before you go
          </div>
          <p>Google Maps does not provide the correct route to our location. Please use one of the trusted routes below.</p>
        </div>

        {location?.body && location.body.length > 0 && (
          <div class="location-body">
            {location.body.map((block: PortableTextBlock) => {
              const b = block as any;
              if (b._type === 'block') {
                const text = (b.children ?? []).map((c: any) => c.text ?? '').join('');
                return text ? <p>{text}</p> : null;
              }
              return null;
            })}
          </div>
        )}

        <div class="routes">
          <a class="route" href="https://goo.gl/maps/xEuPsaEcBqyGasYk7" target="_blank" rel="noopener">
            <div class="route__left">
              <span class="route__from">Coming from</span>
              <span class="route__name">AP-7 <em>Autopista del Mediterráneo</em></span>
            </div>
            <span class="route__arrow">
              Open route
              <svg viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 5 H17"/><path d="M12 1 L17 5 L12 9"/>
              </svg>
            </span>
          </a>
          <a class="route" href="https://www.google.com/maps/dir/?api=1&destination=La+Cueva+de+Miravet,+12595+Cabanes,+Castell%C3%B3" target="_blank" rel="noopener">
            <div class="route__left">
              <span class="route__from">Coming from</span>
              <span class="route__name">CV-10 <em>Inland route</em></span>
            </div>
            <span class="route__arrow">
              Open route
              <svg viewBox="0 0 18 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 5 H17"/><path d="M12 1 L17 5 L12 9"/>
              </svg>
            </span>
          </a>
        </div>
      </div>

      <!-- Map — Sanity embed if provided, else decorative SVG -->
      <div class="map" data-animate aria-label="Map showing La Cueva de Miravet">
        {location?.mapEmbedUrl && (
          <iframe
            src={location.mapEmbedUrl}
            class="map__iframe"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map showing La Cueva de Miravet"
            aria-label="Google Maps embed"
          ></iframe>
        )}
        <svg class="map__svg" viewBox="0 0 600 650" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <linearGradient id="mapFade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2D4A3E" stop-opacity="0"/>
              <stop offset="1" stop-color="#1A2A23" stop-opacity="0.6"/>
            </linearGradient>
            <pattern id="hatch" width="3" height="3" patternUnits="userSpaceOnUse">
              <path d="M0 3 L3 0" stroke="rgba(255,255,255,0.05)" stroke-width="0.6"/>
            </pattern>
          </defs>
          <path d="M420 0 Q 460 200 480 320 T 520 540 L 600 600 L 600 0 Z" fill="url(#hatch)" opacity="0.7"/>
          <path d="M420 0 Q 460 200 480 320 T 520 540 L 600 600 L 600 0 Z" fill="rgba(74,94,69,0.18)"/>
          <path d="M420 0 Q 460 200 480 320 T 520 540 L 530 650" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.2"/>
          <g fill="none" stroke="rgba(196,98,45,0.18)" stroke-width="1">
            <path d="M40 280 Q 200 240 380 280 Q 420 295 410 320"/>
            <path d="M70 250 Q 220 215 360 255 Q 405 280 395 305"/>
            <path d="M100 220 Q 240 190 340 230 Q 390 260 380 290"/>
            <path d="M140 195 Q 260 170 320 210 Q 375 245 365 275"/>
            <path d="M180 175 Q 270 158 305 195 Q 355 230 350 260"/>
          </g>
          <g fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.8">
            <path d="M20 460 Q 120 430 220 480 Q 280 510 240 560"/>
            <path d="M40 440 Q 130 415 210 460 Q 260 490 230 530"/>
          </g>
          <g fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="1.2" stroke-dasharray="4 4">
            <path d="M460 50 Q 470 200 490 380 T 510 620"/>
            <path d="M180 30 Q 240 150 280 280 Q 310 380 340 480 Q 360 560 400 640"/>
          </g>
          <g>
            <circle cx="430" cy="430" r="3" fill="rgba(255,255,255,0.55)"/>
            <circle cx="300" cy="500" r="3" fill="rgba(255,255,255,0.55)"/>
            <circle cx="380" cy="120" r="3" fill="rgba(255,255,255,0.55)"/>
          </g>
          <rect x="0" y="0" width="600" height="650" fill="url(#mapFade)"/>
        </svg>

        <span class="map__label map__label--med">Mar Mediterrani</span>
        <span class="map__label" style="top: 67%; left: 47%;">Benicàssim</span>
        <span class="map__label" style="top: 80%; left: 12%;">Desert de les Palmes</span>
        <span class="map__label" style="top: 17%; left: 58%;">Peñíscola</span>

        <div class="map__pin">
          <svg class="map__pin-marker" viewBox="0 0 22 28" fill="currentColor">
            <path d="M11 0 C 4.9 0 0 4.9 0 11 C 0 19 11 28 11 28 C 11 28 22 19 22 11 C 22 4.9 17.1 0 11 0 Z"/>
            <circle cx="11" cy="11" r="4.2" fill="#FDFCF8"/>
          </svg>
          <span class="map__pin-ring"></span>
          <span class="map__pin-label">La Cueva de Miravet</span>
        </div>

        <div class="map__compass" aria-hidden="true">
          <svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1">
            <circle cx="28" cy="28" r="22"/><circle cx="28" cy="28" r="16"/>
            <path d="M28 8 L31 28 L28 28 Z" fill="currentColor"/>
            <text x="28" y="6" text-anchor="middle" font-family="Inter" font-size="7" fill="currentColor" letter-spacing="1">N</text>
          </svg>
        </div>

        <div class="map__scale">
          <span>5 km</span>
          <span class="map__scale-bar"></span>
        </div>

        <div class="map__legend">
          <strong>40°07'N · 0°04'E</strong>
          <span>The Lodge</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== How to arrive ===== -->
  <section class="arrive">
    <div class="arrive__header" data-animate>
      <div>
        <span class="label">How to arrive</span>
        <h2>Three ways to the mountain.<span class="italic"> All of them quiet by the end.</span></h2>
      </div>
      <p class="note">However you come, the last fifteen minutes feel like the trip is just beginning. Olive groves, then a single-track road, then open sky.</p>
    </div>

    <div class="arrive__grid">
      <article class="mode" data-animate>
        <span class="mode__num">I.</span>
        <div class="mode__icon">
          <svg viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 28 H40 V34 a2 2 0 0 1 -2 2 H34 a2 2 0 0 1 -2 -2 V32 H12 V34 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 Z"/>
            <path d="M6 28 L10 18 a3 3 0 0 1 3 -2 H31 a3 3 0 0 1 3 2 L38 28"/>
            <circle cx="11" cy="32" r="2"/><circle cx="33" cy="32" r="2"/><path d="M14 22 H30"/>
          </svg>
        </div>
        <h3 class="mode__name">By car<span class="italic"> En coche</span></h3>
        <p class="mode__sub">The recommended way</p>
        <p class="mode__body">From the AP-7 motorway, take exit 45 and follow signage to Cabanes. The final approach is a single-track mountain lane — slow, narrow, worth it. Free parking on the estate.</p>
        <ul class="mode__details">
          <li><span>From Valencia</span><strong>1 h 15</strong></li>
          <li><span>From Barcelona</span><strong>3 hrs</strong></li>
          <li><span>From Madrid</span><strong>4 h 30</strong></li>
        </ul>
      </article>

      <article class="mode" data-animate>
        <span class="mode__num">II.</span>
        <div class="mode__icon">
          <svg viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="10" y="6" width="24" height="26" rx="4"/>
            <path d="M10 22 H34"/>
            <circle cx="16" cy="14" r="1.8"/><circle cx="28" cy="14" r="1.8"/>
            <path d="M14 32 L10 38"/><path d="M30 32 L34 38"/>
            <circle cx="16" cy="27" r="1.2" fill="currentColor"/><circle cx="28" cy="27" r="1.2" fill="currentColor"/>
          </svg>
        </div>
        <h3 class="mode__name">By train<span class="italic"> En tren</span></h3>
        <p class="mode__sub">Then a short taxi</p>
        <p class="mode__body">Renfe high-speed lines run from Madrid, Barcelona and Valencia to Benicàssim. We arrange the final twenty-minute taxi through a local driver — let us know your train and we'll meet you at the station.</p>
        <ul class="mode__details">
          <li><span>Nearest station</span><strong>Benicàssim</strong></li>
          <li><span>To the lodge</span><strong>20 min taxi</strong></li>
          <li><span>From Valencia</span><strong>1 h 10</strong></li>
        </ul>
      </article>

      <article class="mode" data-animate>
        <span class="mode__num">III.</span>
        <div class="mode__icon">
          <svg viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 26 L18 23 L26 6 L30 6 L26 24 L40 22 L40 26 L26 30 L22 40 L18 40 L18 30 L4 32 Z"/>
          </svg>
        </div>
        <h3 class="mode__name">By air<span class="italic"> En avión</span></h3>
        <p class="mode__sub">Valencia or Castellón</p>
        <p class="mode__body">Valencia Airport (VLC) has the widest schedule and is ninety minutes by car. Castellón Costa Azahar (CDT) is closer — forty minutes — with seasonal routes. Hire a car or we'll send a driver.</p>
        <ul class="mode__details">
          <li><span>Valencia (VLC)</span><strong>90 min</strong></li>
          <li><span>Castellón (CDT)</span><strong>40 min</strong></li>
          <li><span>Barcelona (BCN)</span><strong>3 hrs</strong></li>
        </ul>
      </article>
    </div>
  </section>

  <!-- ===== Nearby ===== -->
  <section class="nearby">
    <div class="nearby__header" data-animate>
      <div class="left">
        <span class="label">While you're here</span>
        <h2>The neighbours.<span class="italic"> Worth a half-day each.</span></h2>
      </div>
      <p class="right">Four places we send guests to when they ask, "Where should we go for the afternoon?" — and one we send them to twice.</p>
    </div>

    <div class="nearby__grid" data-animate>
      <a href="#" class="place">
        <div class="place__img-wrap">
          <span class="place__chip">Coastal town</span>
          <div class="place__img" style="background-color:#7A8FA0;"></div>
        </div>
        <div class="place__body">
          <span class="place__name">Peñíscola</span>
          <span class="place__sub">The walled town on the sea</span>
          <div class="place__meta">
            <span class="place__distance"><strong>45 min</strong>by car · 38 km</span>
            <span class="place__arrow">North →</span>
          </div>
        </div>
      </a>

      <a href="#" class="place">
        <div class="place__img-wrap">
          <span class="place__chip">Beach &amp; rail</span>
          <div class="place__img" style="background-color:#C4A878;"></div>
        </div>
        <div class="place__body">
          <span class="place__name">Benicàssim</span>
          <span class="place__sub">Belle Époque on the coast</span>
          <div class="place__meta">
            <span class="place__distance"><strong>20 min</strong>by car · 16 km</span>
            <span class="place__arrow">East →</span>
          </div>
        </div>
      </a>

      <a href="#" class="place">
        <div class="place__img-wrap">
          <span class="place__chip">Capital</span>
          <div class="place__img" style="background-color:#9A8A6E;"></div>
        </div>
        <div class="place__body">
          <span class="place__name">Castellón</span>
          <span class="place__sub">The provincial city</span>
          <div class="place__meta">
            <span class="place__distance"><strong>30 min</strong>by car · 28 km</span>
            <span class="place__arrow">South →</span>
          </div>
        </div>
      </a>

      <a href="#" class="place">
        <div class="place__img-wrap">
          <span class="place__chip">Natural park</span>
          <div class="place__img" style="background-color:#5E6F4F;"></div>
        </div>
        <div class="place__body">
          <span class="place__name">Desert de les Palmes</span>
          <span class="place__sub">The mountain at the door</span>
          <div class="place__meta">
            <span class="place__distance"><strong>15 min</strong>by car · 10 km</span>
            <span class="place__arrow">West →</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ===== Ready strip ===== -->
  <section class="ready">
    <div class="ready__inner" data-animate>
      <h2>Now you know the way.<span class="italic"> Pick a room.</span></h2>
      <div class="ready__cta">
        <a href={`${p}/book`} class="btn">Check Availability</a>
        <span class="note">Best rate guaranteed — book direct.</span>
      </div>
    </div>
  </section>

</Base>

<style>
.label {
  font-family: var(--font-sans); font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.14em; color: var(--stone-mid);
}
.italic { font-style: italic; }

/* ===== Hero ===== */
.hero {
  position: relative; min-height: 88vh;
  background-color: var(--stone-dark);
  background-image: var(--grain); background-blend-mode: multiply;
  overflow: hidden; color: var(--white);
  display: flex; flex-direction: column; justify-content: center;
  padding: 160px 40px 80px;
}
.hero::before {
  content: ""; position: absolute; inset: 0;
  background: radial-gradient(ellipse 70% 60% at 22% 50%, rgba(196,98,45,0.08) 0%, transparent 60%), radial-gradient(ellipse at center, rgba(255,255,255,0.025) 0%, transparent 70%);
  pointer-events: none;
}
.hero__topo { position: absolute; inset: 0; pointer-events: none; opacity: 0.4; }
.hero__topo svg { width: 100%; height: 100%; }
.hero__inner {
  position: relative; z-index: 2;
  max-width: 1400px; width: 100%; margin: 0 auto;
  display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 80px;
}
.hero__label {
  color: rgba(255,255,255,0.6); margin-bottom: 28px;
  display: flex; align-items: center; gap: 16px;
}
.pip { width: 6px; height: 6px; background: var(--terra); border-radius: 50%; display: inline-block; }
.hero h1 {
  font-family: var(--font-serif);
  font-size: 132px; font-weight: 300;
  letter-spacing: -0.03em; line-height: 0.95;
  color: var(--white);
}
.hero h1 .italic { color: rgba(255,255,255,0.55); }
.hero__coords { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding-bottom: 14px; min-width: 360px; }
.label-row { display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,0.55); font-family: var(--font-sans); font-size: 10px; text-transform: uppercase; letter-spacing: 0.16em; }
.rule { width: 28px; height: 1px; background: rgba(255,255,255,0.35); display: inline-block; }
.value { font-family: var(--font-sans); font-size: 18px; font-weight: 400; letter-spacing: 0.04em; color: var(--white); }
.elev { font-family: var(--font-serif); font-style: italic; font-size: 18px; color: rgba(255,255,255,0.7); margin-top: 4px; }
.elev strong { font-family: var(--font-sans); font-style: normal; font-weight: 400; color: var(--white); }
.hero__scroll { position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%); z-index: 3; display: flex; flex-direction: column; align-items: center; gap: 14px; color: rgba(255,255,255,0.55); font-family: var(--font-sans); font-size: 10px; text-transform: uppercase; letter-spacing: 0.18em; }
.line { width: 1px; height: 36px; background: rgba(255,255,255,0.25); position: relative; overflow: hidden; }
.line::after { content: ""; position: absolute; top: -8px; left: 0; width: 100%; height: 8px; background: var(--white); animation: dropline 2.4s ease-in-out infinite; }
@keyframes dropline { 0% { top: -8px; opacity: 0; } 25% { opacity: 1; } 75% { opacity: 1; } 100% { top: 36px; opacity: 0; } }

/* ===== Address ===== */
.address { background: var(--cream); padding: 140px 40px; }
.address__grid { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.05fr; gap: 100px; align-items: start; }
.address__left .label { margin-bottom: 22px; display: block; }
.address__left h2 { font-family: var(--font-serif); font-size: 44px; font-weight: 300; margin-bottom: 28px; max-width: 480px; }
.address__addr { font-family: var(--font-serif); font-style: italic; font-size: 24px; color: var(--stone-dark); line-height: 1.4; margin-bottom: 8px; font-weight: 300; }
.address__addr-sub { font-family: var(--font-sans); font-size: 13px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--stone-mid); margin-bottom: 40px; }
.address__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 32px; margin-bottom: 48px; padding-bottom: 40px; border-bottom: 1px solid var(--stone-light); }
.address__stat { display: flex; flex-direction: column; gap: 6px; }
.address__stat .k { font-family: var(--font-sans); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--stone-mid); }
.address__stat .v { font-family: var(--font-serif); font-style: italic; font-weight: 300; font-size: 28px; line-height: 1.1; color: var(--stone-dark); }
.address__stat .v small { font-family: var(--font-sans); font-style: normal; font-size: 13px; color: var(--stone-mid); display: block; margin-top: 2px; }
.notice { background: rgba(196,98,45,0.07); border-left: 2px solid var(--terra); padding: 22px 24px; margin-bottom: 32px; }
.notice .heading { display: flex; align-items: center; gap: 10px; color: var(--terra); font-family: var(--font-sans); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 10px; }
.notice p { font-family: var(--font-serif); font-style: italic; font-size: 17px; color: var(--stone-dark); line-height: 1.55; font-weight: 300; }
.routes { display: flex; flex-direction: column; gap: 0; }
.route { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 22px 4px; border-bottom: 1px solid var(--stone-light); transition: border-color 0.4s ease; }
.route:hover { border-color: var(--terra); }
.route__left { display: flex; align-items: center; gap: 18px; transition: transform 0.45s ease; }
.route:hover .route__left { transform: translateX(6px); }
.route__from { font-family: var(--font-sans); font-size: 10px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--stone-mid); }
