---
import Base from '../../layouts/Base.astro';
import { ROOM_BY_SLUG_QUERY, ALL_ROOMS_QUERY } from '../../lib/sanity/queries';
import type { Room, RoomListItem } from '../../types/sanity';
import { prefix } from '../../i18n/utils';
import { loadQuery } from '@/lib/load-query';
import { getDraftModeProps } from '@/lib/draft-mode';

const { slug } = Astro.params;
const lang = 'en';
const p    = prefix(lang);

const [{ data: room }, { data: adjacentRooms }] = await Promise.all([
  loadQuery<Room | null>({
    query: ROOM_BY_SLUG_QUERY,
    params: { slug, locale: lang },
    ...getDraftModeProps(Astro.cookies),
  }),
  loadQuery<RoomListItem[]>({
    query: ALL_ROOMS_QUERY,
    params: { locale: lang },
    ...getDraftModeProps(Astro.cookies),
  }),
]);

// Per-room wireframe fallbacks
const wireframeData: Record<string, {
  subtitle: string; name: string; nameEn: string;
  tagline: string; price: number; color: string;
  description: string[]; bedType: string;
}> = {
  olivo:    { subtitle: 'Olive Suite',      name: 'Olivo',    nameEn: 'The Olive Tree',  tagline: 'Carved into the natural rock face. Constant 16°C, lit by candle and skylight.',            price: 420, color: '#5C4838', description: ['Olivo sits inside the natural rock itself — the oldest room in the house by several thousand years. The walls are the mountain.', 'A double bed on a raised platform, linen undyed, a skylight above.'], bedType: 'Double · linen' },
  lavanda:  { subtitle: 'Lavender Suite',   name: 'Lavanda',  nameEn: 'The Lavender',    tagline: 'Private sea-view terrace with day bed and outdoor bath.',                                   price: 380, color: '#8FA59A', description: ['Lavanda opens west. A full-length sliding door onto a private terrace with a daybed, a stone outdoor bathtub, and an uninterrupted view over the valley to the Mediterranean.'], bedType: 'King · linen' },
  laurel:   { subtitle: 'Bay Laurel Suite', name: 'Laurel',   nameEn: 'The Bay Laurel',  tagline: 'Floor-to-ceiling windows facing south. Mountains on one side, Mediterranean on the other.', price: 340, color: '#B8A48A', description: ['Laurel is the room most guests photograph from outside. Floor-to-ceiling south-facing glass, a king bed aligned to the view.'], bedType: 'King · linen' },
  tomillo:  { subtitle: 'Thyme Suite',      name: 'Tomillo',  nameEn: 'The Thyme',       tagline: 'Original 19th-century beams. A double bed beneath the old hayloft window.',                 price: 310, color: '#7E6E58', description: ['Tomillo was the old hayloft. The original 19th-century beams are overhead, the hayloft window is still in the same position.'], bedType: 'Double · linen' },
  almendro: { subtitle: 'Almond Suite',     name: 'Almendro', nameEn: 'The Almond Tree', tagline: 'King bed, exposed beams, a private balcony.',                                                price: 290, color: '#6F8366', description: ['Almendro is a room that pays attention. Original beams overhead, the tile floor cool underfoot.'], bedType: 'King · linen' },
  roble:    { subtitle: 'Oak Suite',        name: 'Roble',    nameEn: 'The Oak',         tagline: 'Warm timber, a private terrace with sun-beds and a view of the Mediterranean.',              price: 260, color: '#9A8A74', description: ['Roble is the room with the most timber — original oak throughout, a beamed ceiling, and a private terrace.'], bedType: 'King · linen' },
  hinojo:   { subtitle: 'Fennel Suite',     name: 'Hinojo',   nameEn: 'The Fennel',      tagline: 'Vaulted brick ceilings, a single deep window. Cool and quiet, year round.',                  price: 240, color: '#4A3F35', description: ['Hinojo is the coolest room — vaulted brick overhead, a single deep window set into a metre of stone wall.'], bedType: 'Double · linen' },
};
const wf = wireframeData[slug as keyof typeof wireframeData] ?? wireframeData.almendro;

// Resolve values — Sanity first, wireframe fallback
const roomName        = room?.name            ?? wf.name;
const roomNameEn      = room?.nameTranslation ?? wf.nameEn;
const roomSub         = room?.subtitle        ?? wf.subtitle;
const roomTagline     = room?.tagline         ?? wf.tagline;
const roomPrice       = room?.pricePerNight   ?? wf.price;
const roomBed         = room?.bedType         ?? wf.bedType;
const roomSleeps      = room?.sleeps          ?? null;
const roomSize        = room?.size            ?? null;
const roomView        = room?.view            ?? null;
const roomBalcony     = room?.balcony         ?? null;
const roomBathroom    = room?.bathroom        ?? null;
const roomMaterials   = room?.materials       ?? null;
const roomHeating     = room?.heating         ?? null;
const roomDesc        = room?.description     ?? wf.description.join('\n\n');
const roomAmenities   = room?.amenities       ?? [];
const heroImgUrl      = room?.imageUrl        ?? null;
const gallery         = room?.gallery         ?? [];

// Adjacent rooms (exclude current, show up to 3)
const swatchColors: Record<string, string> = {
  olivo: '#5C4838', lavanda: '#8FA59A', laurel: '#B8A48A',
  tomillo: '#7E6E58', almendro: '#6F8366', roble: '#9A8A74', hinojo: '#4A3F35',
};
const others = adjacentRooms.length > 0
  ? adjacentRooms.filter(r => r.slug?.current !== slug).slice(0, 3)
  : Object.entries(wireframeData)
      .filter(([s]) => s !== slug)
      .slice(0, 3)
      .map(([s, d]) => ({ _id: s, slug: { current: s }, name: d.name, subtitle: d.subtitle, tagline: d.tagline, pricePerNight: d.price, imageUrl: null, imageAlt: null })) as RoomListItem[];

const galleryPlaceholders = [
  { url: null, alt: 'The bed, the beams.', color: '#C8B89E' },
  { url: null, alt: 'The balcony.',        color: '#8B9A7A' },
  { url: null, alt: 'The bathroom.',       color: '#A88A6B' },
];
const galleryItems = gallery.length > 0 ? gallery : galleryPlaceholders;

// Hero background style
const heroBgStyle = heroImgUrl
  ? `background-color: ${wf.color}; background-image: radial-gradient(ellipse at 70% 30%,rgba(232,206,178,.35) 0%,transparent 55%),radial-gradient(ellipse at 30% 80%,rgba(74,94,69,.2) 0%,transparent 60%),linear-gradient(180deg,rgba(0,0,0,.35) 0%,rgba(0,0,0,.1) 35%,rgba(0,0,0,.65) 100%),var(--grain),url('${heroImgUrl}'); background-size: cover; background-position: center;`
  : `background-color: ${wf.color}; background-image: radial-gradient(ellipse at 70% 30%,rgba(232,206,178,.35) 0%,transparent 55%),radial-gradient(ellipse at 30% 80%,rgba(74,94,69,.2) 0%,transparent 60%),linear-gradient(180deg,rgba(0,0,0,.35) 0%,rgba(0,0,0,.1) 35%,rgba(0,0,0,.65) 100%),var(--grain)`;
---

<Base
  title={`${roomName} · La Cueva de Miravet`}
  description={roomTagline}
  activePage="stay"
  lang={lang}
>

  <!-- ===== Image hero ===== -->
  <section class="img-hero" style={heroBgStyle}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href={`${p}/stay`}>Stay</a>
      <span class="sep">/</span>
      <span class="current">{roomName}</span>
    </nav>

    <div class="img-hero__inner">
      <div class="img-hero__title-block">
        <span class="label img-hero__label">{roomSub}</span>
        <h1>{roomName} <span class="italic-tag">/ {roomNameEn}</span></h1>
        <p class="img-hero__sub">{roomTagline}</p>
      </div>
      <div class="img-hero__meta">
        <div class="img-hero__meta-item">
          <span class="img-hero__meta-label">Bed</span>
          <span class="img-hero__meta-value">{roomBed}</span>
        </div>
        {roomSize && (
          <div class="img-hero__meta-item">
            <span class="img-hero__meta-label">Size</span>
            <span class="img-hero__meta-value">{roomSize}</span>
          </div>
        )}
        {roomSleeps && (
          <div class="img-hero__meta-item">
            <span class="img-hero__meta-label">Sleeps</span>
            <span class="img-hero__meta-value">{roomSleeps}</span>
          </div>
        )}
        <div class="img-hero__meta-item">
          <span class="img-hero__meta-label">From</span>
          <span class="img-hero__meta-value">€{roomPrice} / night</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Intro ===== -->
  <section class="intro">
    <div class="intro__grid">

      <div class="intro__left" data-animate>
        <div class="intro__body">
          {roomDesc.split('\n\n').map((para, i) => (
            <p class={i === 0 ? 'dropcap' : ''}>{para}</p>
          ))}
        </div>

        <div class="features">
          <span class="label features__label">The Particulars</span>
          <ul class="features__list">
            {roomBed      && <li><span class="key">Bed</span>      <span class="val">{roomBed}</span></li>}
            {roomSize     && <li><span class="key">Size</span>     <span class="val">{roomSize}</span></li>}
            {roomSleeps   && <li><span class="key">Sleeps</span>   <span class="val">{roomSleeps}</span></li>}
            {roomView     && <li><span class="key">View</span>     <span class="val">{roomView}</span></li>}
            {roomBalcony  && <li><span class="key">Balcony</span>  <span class="val">{roomBalcony}</span></li>}
            {roomBathroom && <li><span class="key">Bathroom</span> <span class="val">{roomBathroom}</span></li>}
            {roomMaterials && <li><span class="key">Materials</span><span class="val">{roomMaterials}</span></li>}
            {roomHeating  && <li><span class="key">Heating</span>  <span class="val">{roomHeating}</span></li>}
            {roomAmenities.map(a => (
              <li><span class="key">Includes</span><span class="val">{a}</span></li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="booking-card" data-animate>
        <div class="booking-card__img-wrap">
          {heroImgUrl
            ? <img src={heroImgUrl} alt={room?.imageAlt ?? roomName} loading="lazy" />
            : <div class="booking-card__img" style={`background-color: ${wf.color};`}></div>
          }
        </div>
        <div class="booking-card__body">
          <div class="booking-card__price-row">
            <div>
              <span class="booking-card__price-from">From</span>
              <div class="booking-card__price">€{roomPrice}<span class="per">/ night</span></div>
            </div>
            <div class="booking-card__nights">2-night minimum stay · Breakfast included</div>
          </div>
          <ul class="booking-card__bullets">
            <li>Best rate guaranteed when booking direct</li>
            <li>Flexible cancellation up to 14 days before</li>
            <li>Welcome carafe of valley wine on arrival</li>
          </ul>
          <a href={`${p}/book`} class="btn-terra">Request to Book</a>
          <p class="booking-card__note">No payment until we confirm. <em>Usually within a few hours.</em></p>
        </div>
      </aside>

    </div>
  </section>

  <!-- ===== Gallery ===== -->
  <section class="gallery" aria-label={`${roomName} gallery`}>
    <div class="gallery__grid">
      {galleryItems.map((img) => (
        img.url
          ? <div class="gallery__img" style={`background-image: url('${img.url}'); background-size: cover; background-position: center;`} role="img" aria-label={img.alt ?? roomName}>
              {img.alt && <span class="gallery__caption">{img.alt}</span>}
            </div>
          : <div class="gallery__img" style={`background-color: ${(img as any).color ?? '#C8B89E'};`} role="img" aria-label={img.alt ?? roomName}>
              {img.alt && <span class="gallery__caption">{img.alt}</span>}
            </div>
      ))}
    </div>
  </section>

  <!-- ===== What's included ===== -->
  <section class="included">
    <div class="included__header" data-animate>
      <span class="label">What's included</span>
      <h2>Everything you'd hope for.<br/><span class="italic" style="color:var(--stone-mid);">Nothing you wouldn't.</span></h2>
      <p>Breakfast from the valley below, mountain WiFi where you want it and none where you don't, and the kind of quiet you forget existed.</p>
    </div>

    <div class="amenities__grid" data-animate>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22 H28 V26 H4 Z"/><path d="M4 22 V14 a2 2 0 0 1 2 -2 H26 a2 2 0 0 1 2 2 V22"/><path d="M9 14 a2 2 0 0 1 2 -2 H15 V18 H9 Z"/><path d="M15 14 a2 2 0 0 1 2 -2 H21 a2 2 0 0 1 2 2 V18 H15 Z"/></svg>
        <span class="amenity__label">{roomBed}</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 22 H29"/><path d="M3 26 H29"/><path d="M6 22 Q16 8 26 22"/></svg>
        <span class="amenity__label">Mountain Terrace</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="22" cy="10" r="4"/><path d="M22 14 V28"/><path d="M14 28 H30"/><path d="M4 18 H12 V28 H4 Z"/></svg>
        <span class="amenity__label">Natural Light</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4 Q12 8 8 14 Q4 20 8 28"/><path d="M16 4 Q20 8 16 14 Q12 20 16 28"/><path d="M24 4 Q28 8 24 14 Q20 20 24 28"/></svg>
        <span class="amenity__label">Rain Shower</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8 H26 V24 H6 Z"/><path d="M6 12 H26"/><circle cx="22" cy="10" r="0.6" fill="currentColor"/><path d="M11 18 q2 -3 5 0 t5 0"/></svg>
        <span class="amenity__label">Breakfast Included</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="22" r="2"/><path d="M11 18 q5 -5 10 0"/><path d="M7 14 q9 -8 18 0"/><path d="M3 10 q13 -10 26 0"/></svg>
        <span class="amenity__label">WiFi</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="6"/><path d="M16 4 V8"/><path d="M16 24 V28"/><path d="M4 16 H8"/><path d="M24 16 H28"/></svg>
        <span class="amenity__label">Solar-Heated Water</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 10 q-2 6 0 12 q2 6 6 6 q4 0 6 -6 q2 -6 0 -12"/><path d="M10 10 q3 -4 6 -4 q3 0 6 4"/><path d="M16 6 V2"/></svg>
        <span class="amenity__label">Welcome Carafe</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="20" height="24" rx="2"/><path d="M11 10 H21"/><path d="M11 15 H21"/><path d="M11 20 H17"/></svg>
        <span class="amenity__label">Writing Table</span>
      </div>
    </div>
  </section>

  <!-- ===== Adjacent rooms ===== -->
  <section class="adjacent">
    <div class="adjacent__header" data-animate>
      <div class="left">
        <span class="label">Adjacent rooms</span>
        <h2>Other corners of the masia.<span class="italic"> All seven, side by side.</span></h2>
      </div>
      <div class="right">
        <a href={`${p}/stay`}>View all seven rooms →</a>
      </div>
    </div>

    <div class="adjacent__grid" data-animate>
      {others.map((r) => {
        const rSlug  = r.slug?.current ?? '';
        const rWf    = wireframeData[rSlug] ?? wireframeData.olivo;
        const rColor = swatchColors[rSlug] ?? '#9A8A74';
        return (
          <a href={`${p}/stay/${rSlug}`} class="room-card">
            <div class="room-card__img-wrap">
              {r.imageUrl
                ? <img src={r.imageUrl} alt={r.imageAlt ?? r.name ?? rSlug} loading="lazy" />
                : <div class="room-card__img" style={`background-color: ${rColor};`}></div>
              }
            </div>
            <div class="room-card__body">
              <p class="room-card__type">{r.subtitle ?? rWf.subtitle}</p>
              <h3 class="room-card__name">{r.name ?? rWf.name}</h3>
              <p class="room-card__feature">{r.tagline ?? rWf.tagline}</p>
              <div class="room-card__divider"></div>
              <div class="room-card__row">
                <p class="room-card__price"><strong>€{r.pricePerNight ?? rWf.price}</strong><span class="per">/ night</span></p>
                <span class="room-card__cta">View room</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

</Base>

<style>
.label {
  font-family: var(--font-sans); font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.12em; color: var(--stone-mid);
}
.italic { font-style: italic; }

/* ===== Image hero ===== */
.img-hero {
  position: relative; height: 70vh; min-height: 600px;
  background-size: cover; background-position: center;
  overflow: hidden;
}
.img-hero::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: 0;
  height: 6px; background: var(--terra); z-index: 4;
}
.breadcrumb {
  position: absolute; top: 100px; left: 40px; z-index: 5;
  display: flex; align-items: center; gap: 12px;
  color: rgba(255,255,255,0.7); font-family: var(--font-sans);
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em;
}
.breadcrumb a { transition: color 0.2s ease; }
.breadcrumb a:hover { color: var(--white); }
.breadcrumb .sep { color: rgba(255,255,255,0.35); }
.breadcrumb .current { color: var(--white); }

.img-hero__inner {
  position: absolute; bottom: 56px; left: 40px; right: 40px;
  color: var(--white); z-index: 3;
  display: flex; align-items: flex-end; justify-content: space-between; gap: 40px;
}
.img-hero__title-block { max-width: 760px; }
.img-hero__label { color: rgba(255,255,255,0.7); margin-bottom: 18px; display: block; }
.img-hero__inner h1 {
  font-family: var(--font-serif); font-size: 96px; font-weight: 300;
  letter-spacing: -0.02em; line-height: 0.98; color: var(--white); margin-bottom: 14px;
}
.italic-tag {
  font-style: italic; font-size: 36px; color: rgba(255,255,255,0.7);
  margin-left: 18px; vertical-align: 18px; font-weight: 300;
}
.img-hero__sub {
  font-family: var(--font-serif); font-style: italic; font-size: 22px;
  font-weight: 300; color: rgba(255,255,255,0.88); max-width: 540px; line-height: 1.4;
}
.img-hero__meta { display: flex; gap: 36px; align-items: flex-end; flex-shrink: 0; padding-bottom: 6px; }
.img-hero__meta-item { display: flex; flex-direction: column; gap: 4px; }
.img-hero__meta-label { font-family: var(--font-sans); font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.14em; color: rgba(255,255,255,0.55); }
.img-hero__meta-value { font-family: var(--font-serif); font-style: italic; font-size: 22px; color: var(--white); font-weight: 300; }

/* ===== Intro ===== */
.intro { background: var(--cream); padding: 120px 40px; }
.intro__grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.45fr 1fr; gap: 120px; align-items: start; }
.intro__body { font-size: 16px; line-height: 1.85; color: var(--stone-dark); max-width: 520px; text-wrap: pretty; }
.intro__body p + p { margin-top: 18px; }
.intro__body .dropcap::first-letter { font-family: var(--font-serif); font-style: italic; font-weight: 300; font-size: 72px; line-height: 0.85; float: left; padding: 6px 14px 0 0; color: var(--terra); }

.features { margin-top: 56px; border-top: 1px solid var(--stone-light); padding-top: 32px; }
.features__label { display: block; margin-bottom: 24px; }
.features__list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 18px 40px; }
.features__list li { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 14px; border-bottom: 1px solid var(--stone-light); gap: 16px; }
.features__list .key { font-family: var(--font-sans); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--stone-mid); flex-shrink: 0; }
.features__list .val { font-family: var(--font-serif); font-style: italic; font-size: 18px; color: var(--stone-dark); text-align: right; line-height: 1.2; }

/* Booking card */
.booking-card { position: sticky; top: 110px; display: flex; flex-direction: column; align-items: stretch; }
.booking-card__img-wrap { overflow: hidden; border-radius: 200px 200px 0 0; aspect-ratio: 3/4; background-color: #B89F84; }
.booking-card__img-wrap img { width: 100%; height: 100%; object-fit: cover; }
.booking-card__img { width: 100%; height: 100%; background-image: var(--grain); background-blend-mode: multiply; }
.booking-card__body { padding: 32px 4px 0; display: flex; flex-direction: column; gap: 18px; }
.booking-card__price-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 20px; border-bottom: 1px solid var(--stone-light); }
.booking-card__price-from { font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--stone-mid); margin-bottom: 4px; display: block; }
.booking-card__price { font-family: var(--font-serif); font-size: 42px; font-weight: 300; color: var(--stone-dark); line-height: 1; }
.booking-card__price .per { font-size: 14px; color: var(--stone-mid); font-style: italic; margin-left: 4px; }
.booking-card__nights { font-size: 12px; color: var(--stone-mid); line-height: 1.5; text-align: right; max-width: 140px; }
.booking-card__bullets { list-style: none; display: flex; flex-direction: column; gap: 10px; margin: 4px 0 8px; }
.booking-card__bullets li { position: relative; padding-left: 20px; font-size: 13px; color: var(--stone-dark); line-height: 1.5; }
.booking-card__bullets li::before { content: ""; position: absolute; left: 0; top: 9px; width: 10px; height: 1px; background: var(--terra); }
.btn-terra { background: var(--terra); color: var(--white); border-radius: 100px; padding: 16px 32px; font-family: var(--font-sans); font-size: 13px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; text-align: center; transition: background 0.2s ease, transform 0.2s ease; display: block; }
.btn-terra:hover { background: #b1561f; transform: translateY(-1px); }
.booking-card__note { font-size: 12px; color: var(--stone-mid); text-align: center; line-height: 1.5; }
.booking-card__note em { font-style: italic; color: var(--stone-dark); }

/* ===== Gallery ===== */
.gallery { background: var(--cream); }
.gallery__grid { display: grid; grid-template-columns: 1fr 1fr 1fr; }
.gallery__img {
  aspect-ratio: 4/3;
