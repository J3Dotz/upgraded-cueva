---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { client, urlFor } from '../../lib/sanity';
import { roomBySlugQuery, roomSlugsQuery, roomsQuery } from '../../queries/rooms';
import { loc, prefix } from '../../i18n/utils';

export async function getStaticPaths() {
  const sanityRooms = await client.fetch<{ slug: string }[]>(roomSlugsQuery);
  // Always include all 7 wireframe slugs so pages exist before Sanity content is added
  const wireframeSlugs = ['olivo', 'lavanda', 'laurel', 'tomillo', 'almendro', 'roble', 'hinojo'];
  const allSlugs = new Set([...sanityRooms.map((r: any) => r.slug), ...wireframeSlugs]);
  return Array.from(allSlugs).map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const lang = 'en';
const p    = prefix(lang);

const [room, allRooms] = await Promise.all([
  client.fetch(roomBySlugQuery, { slug }),
  client.fetch(roomsQuery),
]);

// Wireframe fallback data per room slug
const wireframeData: Record<string, {
  type: string; name: string; nameEs: string; tagline: string;
  price: number; color: string; sleeps: string; size: string;
  h2: string; body: string[]; bed: string; view: string;
  balcony: string; bathroom: string; materials: string; heating: string;
}> = {
  olivo:    { type: 'Olive Suite',     name: 'Olivo',    nameEs: 'The Olive Tree',  tagline: 'Carved into the natural rock face. Constant 16°C, lit by candle and skylight.',       price: 420, color: '#5C4838', sleeps: '2 guests', size: '28 m²',        h2: 'Rock, candlelight,',              body: ['Olivo sits inside the natural rock itself — the oldest room in the house by several thousand years. The walls are the mountain.', 'A double bed on a raised platform, linen undyed, a skylight above. No windows in the conventional sense. You arrive in darkness and leave having slept better than anywhere in years.'], bed: 'Double · linen', view: 'Skylight only', balcony: 'None', bathroom: 'Private ensuite', materials: 'Rock, limestone', heating: 'Underfloor' },
  lavanda:  { type: 'Lavender Suite',  name: 'Lavanda',  nameEs: 'The Lavender',    tagline: 'Private sea-view terrace with day bed and outdoor bath.',                               price: 380, color: '#8FA59A', sleeps: '2 guests', size: '42 m² + terrace', h2: 'The terrace,',                    body: ['Lavanda opens west. A full-length sliding door onto a private terrace with a daybed, a stone outdoor bathtub, and an uninterrupted view over the valley to the Mediterranean.', 'Inside: pale walls, a king bed, and the particular quality of light that bounces off old whitewash at this elevation.'], bed: 'King · linen', view: 'Sea & valley terrace', balcony: 'Private terrace', bathroom: 'Indoor + outdoor tub', materials: 'Whitewash, stone', heating: 'Wood stove' },
  laurel:   { type: 'Bay Laurel Suite',name: 'Laurel',   nameEs: 'The Bay Laurel',  tagline: 'Floor-to-ceiling windows facing south. Mountains on one side, Mediterranean on the other.', price: 340, color: '#B8A48A', sleeps: '2 guests', size: '38 m²',        h2: 'Mountains and sea,',              body: ['Laurel is the room most guests photograph from outside. Floor-to-ceiling south-facing glass, a king bed aligned to the view, and the kind of light that moves across the room all day.', 'The bathroom has a freestanding ceramic tub in the window. The mountain is the view from the bath.'], bed: 'King · linen', view: 'South: sea + mountain', balcony: 'Juliet balcony', bathroom: 'Freestanding tub', materials: 'Glass, plaster, tile', heating: 'Underfloor' },
  tomillo:  { type: 'Thyme Suite',     name: 'Tomillo',  nameEs: 'The Thyme',       tagline: 'Original 19th-century beams. A double bed beneath the old hayloft window.',             price: 310, color: '#7E6E58', sleeps: '2 guests', size: '32 m²',        h2: 'Beams and hayloft light,',        body: ['Tomillo was the old hayloft. The original 19th-century beams are overhead, the hayloft window is still in the same position. A double bed in undyed linen beneath them.', 'It is a room of warm timber and muted afternoon light. Quieter than the rooms with sea views. People come back to it.'], bed: 'Double · linen', view: 'Garden + valley', balcony: 'None', bathroom: 'Private ensuite', materials: 'Oak beams, plaster', heating: 'Wood stove' },
  almendro: { type: 'Almond Suite',    name: 'Almendro', nameEs: 'The Almond Tree', tagline: 'King bed, exposed beams, a private balcony, and the kind of light that makes you reset your day around it.', price: 290, color: '#6F8366', sleeps: '2 guests', size: '36 m² + balcony', h2: 'Linen, tile,',         body: ['Almendro is a room that pays attention. Original beams overhead, the tile floor cool underfoot, two tall windows and the kind of light that arrives slowly in the morning and stays late into the afternoon.', 'The bed is a king, dressed in undyed linen. A private balcony with a daybed under a linen shade and a small table that fits two for breakfast.'], bed: 'King · linen', view: 'South-facing balcony', balcony: 'Private', bathroom: 'Private ensuite', materials: 'Linen, tile, beams', heating: 'Wood stove' },
  roble:    { type: 'Oak Suite',       name: 'Roble',    nameEs: 'The Oak',         tagline: 'Warm timber, a private terrace with sun-beds and a view of the Mediterranean.',         price: 260, color: '#9A8A74', sleeps: '2 guests', size: '40 m² + terrace', h2: 'Timber and open sky,',            body: ['Roble is the room with the most timber — original oak throughout, a beamed ceiling, and a private terrace with two sun-beds and an unrestricted view of the Mediterranean.', 'A king bed dressed in linen, a bathroom with rain shower and deep stone basin, and the particular warmth that old oak holds long into the evening.'], bed: 'King · linen', view: 'Mediterranean direct', balcony: 'Private terrace', bathroom: 'Stone basin, rain shower', materials: 'Oak, linen, stone', heating: 'Underfloor' },
  hinojo:   { type: 'Fennel Suite',    name: 'Hinojo',   nameEs: 'The Fennel',      tagline: 'Vaulted brick ceilings, a single deep window. Cool and quiet, year round.',             price: 240, color: '#4A3F35', sleeps: '2 guests', size: '30 m²',        h2: 'Vault, stillness,',               body: ['Hinojo is the coolest room — vaulted brick overhead, a single deep window set into a metre of stone wall, and the temperature that old masias held before air conditioning made it unnecessary.', 'The quietest room at the lodge. A double bed, a reading chair, a bathroom with terracotta floor and rain shower. It gets its name from the fennel that grows below the window.'], bed: 'Double · linen', view: 'Garden (north)', balcony: 'None', bathroom: 'Terracotta floor', materials: 'Brick vault, stone', heating: 'Underfloor' },
};

const wf = wireframeData[slug as keyof typeof wireframeData] ?? wireframeData.almendro;

// Resolve values — Sanity first, wireframe fallback
const roomName            = (room?.name        ? loc(room.name, lang)        : null) ?? wf.name;
const roomNameTranslation = room?.nameTranslation ?? wf.nameEs;
const roomSuiteType       = (room?.suiteType   ? loc(room.suiteType, lang)   : null) ?? wf.type;
const roomTagline         = (room?.tagline      ? loc(room.tagline, lang)     : null) ?? wf.tagline;
const roomPrice           = room?.priceFrom ?? wf.price;
const roomColor           = room?.swatchColor ?? wf.color;
const roomBed             = (room?.bedConfig   ? loc(room.bedConfig, lang)   : null) ?? wf.bed;
const roomView            = (room?.view        ? loc(room.view, lang)        : null) ?? wf.view;
const roomBalcony         = (room?.balcony     ? loc(room.balcony, lang)     : null) ?? wf.balcony;
const roomBathroom        = (room?.bathroom    ? loc(room.bathroom, lang)    : null) ?? wf.bathroom;
const roomMaterials       = (room?.materials   ? loc(room.materials, lang)   : null) ?? wf.materials;
const roomHeating         = (room?.heating     ? loc(room.heating, lang)     : null) ?? wf.heating;
const roomSleeps          = room?.sleeps ? `${room.sleeps} guests` : wf.sleeps;
const roomSize            = room?.size ?? wf.size;

const heroImgSrc = room?.images?.[0]
  ? urlFor(room.images[0]).width(1600).height(900).auto('format').url()
  : null;
const cardImgSrc = room?.images?.[1] ?? room?.images?.[0]
  ? urlFor((room?.images?.[1] ?? room?.images?.[0])).width(640).height(860).auto('format').url()
  : null;
const galleryImages = room?.images?.slice(1, 4) ?? [];

// Other rooms for adjacent section
const otherRooms = allRooms.length > 0
  ? allRooms.filter((r: any) => r.slug?.current !== slug).slice(0, 3)
  : Object.entries(wireframeData)
      .filter(([s]) => s !== slug)
      .slice(0, 3)
      .map(([s, d]) => ({ slug: { current: s }, ...d }));

const galleryPlaceholders = [
  { color: '#C8B89E', caption: 'The bed, the beams.' },
  { color: '#8B9A7A', caption: 'The balcony.' },
  { color: '#A88A6B', caption: 'The bathroom.' },
];
---

<Base
  title={`${roomName} · La Cueva de Miravet`}
  description={roomTagline}
  activePage="stay"
  lang={lang}
>

  <!-- ===== Image hero ===== -->
  <section
    class="img-hero"
    style={heroImgSrc
      ? `background-color: ${roomColor}; background-image: radial-gradient(ellipse at 70% 30%, rgba(232,206,178,0.35) 0%, transparent 55%), radial-gradient(ellipse at 30% 80%, rgba(74,94,69,0.2) 0%, transparent 60%), linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.1) 35%, rgba(0,0,0,0.65) 100%), var(--grain), url('${heroImgSrc}')`
      : `background-color: ${roomColor}; background-image: radial-gradient(ellipse at 70% 30%, rgba(232,206,178,0.35) 0%, transparent 55%), radial-gradient(ellipse at 30% 80%, rgba(74,94,69,0.2) 0%, transparent 60%), linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.1) 35%, rgba(0,0,0,0.65) 100%), var(--grain)`}
  >
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href={`${p}/stay`}>Stay</a>
      <span class="sep">/</span>
      <span class="current">{roomName}</span>
    </nav>

    <div class="img-hero__inner">
      <div class="img-hero__title-block">
        <span class="label img-hero__label">{roomSuiteType}</span>
        <h1>{roomName} <span class="italic-tag">/ {roomNameTranslation}</span></h1>
        <p class="img-hero__sub">{roomTagline}</p>
      </div>
      <div class="img-hero__meta">
        <div class="img-hero__meta-item">
          <span class="img-hero__meta-label">Sleeps</span>
          <span class="img-hero__meta-value">{roomSleeps}</span>
        </div>
        <div class="img-hero__meta-item">
          <span class="img-hero__meta-label">Size</span>
          <span class="img-hero__meta-value">{roomSize}</span>
        </div>
        <div class="img-hero__meta-item">
          <span class="img-hero__meta-label">From</span>
          <span class="img-hero__meta-value">€{roomPrice} / night</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Intro ===== -->
  <section class="intro">
    <div class="intro__grid">

      <div class="intro__left" data-animate>
        <h2>{wf.h2}<span class="italic"> and very little else.</span></h2>
        <div class="intro__body">
          {wf.body.map((para, i) => (
            <p class={i === 0 ? 'dropcap' : ''}>{para}</p>
          ))}
        </div>

        <div class="features">
          <span class="label features__label">The Particulars</span>
          <ul class="features__list">
            <li><span class="key">Bed</span><span class="val">{roomBed}</span></li>
            <li><span class="key">Size</span><span class="val">{roomSize}</span></li>
            <li><span class="key">View</span><span class="val">{roomView}</span></li>
            <li><span class="key">Balcony</span><span class="val">{roomBalcony}</span></li>
            <li><span class="key">Bathroom</span><span class="val">{roomBathroom}</span></li>
            <li><span class="key">Materials</span><span class="val">{roomMaterials}</span></li>
            <li><span class="key">Sleeps</span><span class="val">{roomSleeps}</span></li>
            <li><span class="key">Heating</span><span class="val">{roomHeating}</span></li>
          </ul>
        </div>
      </div>

      <aside class="booking-card" data-animate>
        <div class="booking-card__img-wrap">
          {cardImgSrc
            ? <img src={cardImgSrc} alt={roomName} loading="lazy" />
            : <div class="booking-card__img" style={`background-color: ${roomColor};`}></div>
          }
        </div>
        <div class="booking-card__body">
          <div class="booking-card__price-row">
            <div>
              <span class="booking-card__price-from">From</span>
              <div class="booking-card__price">€{roomPrice}<span class="per">/ night</span></div>
            </div>
            <div class="booking-card__nights">2-night minimum stay · Breakfast included</div>
          </div>
          <ul class="booking-card__bullets">
            <li>Best rate guaranteed when booking direct</li>
            <li>Flexible cancellation up to 14 days before</li>
            <li>Welcome carafe of valley wine on arrival</li>
          </ul>
          <a href={`${p}/book`} class="btn-terra">Request to Book</a>
          <p class="booking-card__note">No payment until we confirm. <em>Usually within a few hours.</em></p>
        </div>
      </aside>

    </div>
  </section>

  <!-- ===== Gallery ===== -->
  <section class="gallery" aria-label={`${roomName} gallery`}>
    <div class="gallery__grid">
      {galleryImages.length > 0
        ? galleryImages.map((img: any, i: number) => (
            <div class="gallery__img" style={`background-image: url('${urlFor(img).width(900).height(675).auto('format').url()}')`} role="img" aria-label={img.alt ?? roomName}>
              {img.caption && <span class="gallery__caption">{img.caption}</span>}
            </div>
          ))
        : galleryPlaceholders.map(ph => (
            <div class="gallery__img" style={`background-color: ${ph.color};`} role="img">
              <span class="gallery__caption">{ph.caption}</span>
            </div>
          ))
      }
    </div>
  </section>

  <!-- ===== What's included ===== -->
  <section class="included">
    <div class="included__header" data-animate>
      <span class="label">What's included</span>
      <h2>Everything you'd hope for.<br/><span class="italic" style="color:var(--stone-mid);">Nothing you wouldn't.</span></h2>
      <p>Breakfast from the valley below, mountain WiFi where you want it and none where you don't, and the kind of quiet you forget existed.</p>
    </div>

    <div class="amenities__grid" data-animate>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22 H28 V26 H4 Z"/><path d="M4 22 V14 a2 2 0 0 1 2 -2 H26 a2 2 0 0 1 2 2 V22"/><path d="M9 14 a2 2 0 0 1 2 -2 H15 V18 H9 Z"/><path d="M15 14 a2 2 0 0 1 2 -2 H21 a2 2 0 0 1 2 2 V18 H15 Z"/></svg>
        <span class="amenity__label">{roomBed}</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 22 H29"/><path d="M3 26 H29"/><path d="M6 22 Q16 8 26 22"/></svg>
        <span class="amenity__label">{wf.balcony !== 'None' ? wf.balcony : 'Mountain Terrace'}</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="22" cy="10" r="4"/><path d="M22 14 V28"/><path d="M14 28 H30"/><path d="M4 18 H12 V28 H4 Z"/></svg>
        <span class="amenity__label">Natural Light</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4 Q12 8 8 14 Q4 20 8 28"/><path d="M16 4 Q20 8 16 14 Q12 20 16 28"/><path d="M24 4 Q28 8 24 14 Q20 20 24 28"/></svg>
        <span class="amenity__label">Rain Shower</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8 H26 V24 H6 Z"/><path d="M6 12 H26"/><circle cx="22" cy="10" r="0.6" fill="currentColor"/><path d="M11 18 q2 -3 5 0 t5 0"/></svg>
        <span class="amenity__label">Breakfast Included</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="22" r="2"/><path d="M11 18 q5 -5 10 0"/><path d="M7 14 q9 -8 18 0"/><path d="M3 10 q13 -10 26 0"/></svg>
        <span class="amenity__label">WiFi</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="6"/><path d="M16 4 V8"/><path d="M16 24 V28"/><path d="M4 16 H8"/><path d="M24 16 H28"/></svg>
        <span class="amenity__label">Solar-Heated Water</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 10 q-2 6 0 12 q2 6 6 6 q4 0 6 -6 q2 -6 0 -12"/><path d="M10 10 q3 -4 6 -4 q3 0 6 4"/><path d="M16 6 V2"/></svg>
        <span class="amenity__label">Welcome Carafe</span>
      </div>
      <div class="amenity">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="20" height="24" rx="2"/><path d="M11 10 H21"/><path d="M11 15 H21"/><path d="M11 20 H17"/></svg>
        <span class="amenity__label">Writing Table</span>
      </div>
    </div>
  </section>

  <!-- ===== Adjacent rooms ===== -->
  <section class="adjacent">
    <div class="adjacent__header" data-animate>
      <div class="left">
        <span class="label">Adjacent rooms</span>
        <h2>Other corners of the masia.<span class="italic"> All seven, side by side.</span></h2>
      </div>
      <div class="right">
        <a href={`${p}/stay`}>View all seven rooms →</a>
      </div>
    </div>

    <div class="adjacent__grid" data-animate>
      {otherRooms.map((r: any) => {
        const rSlug  = r.slug?.current ?? r.slug ?? '';
        const rWf    = wireframeData[rSlug] ?? wireframeData.olivo;
        const rName  = (r.name ? loc(r.name, lang) : null) ?? rWf.name;
        const rType  = (r.tagline ? loc(r.tagline, lang) : null) ?? rWf.type;
        const rFeat  = (r.bedConfig ? loc(r.bedConfig, lang) : null) ?? rWf.body[0].substring(0, 80) + '…';
        const rPrice = r.priceFrom ?? rWf.price;
        const rColor = r.swatchColor ?? rWf.color;
        const rImg   = r.images?.[0]
          ? urlFor(r.images[0]).width(480).height(640).auto('format').url()
          : null;
        return (
          <a href={`${p}/stay/${rSlug}`} class="room-card">
            <div class="room-card__img-wrap">
              {rImg
                ? <img src={rImg} alt={rName} loading="lazy" />
                : <div class="room-card__img" style={`background-color: ${rColor};`}></div>
              }
            </div>
            <div class="room-card__body">
              <p class="room-card__type">{rType}</p>
              <h3 class="room-card__name">{rName}</h3>
              <p class="room-card__feature">{rFeat}</p>
              <div class="room-card__divider"></div>
              <div class="room-card__row">
                <p class="room-card__price"><strong>€{rPrice}</strong><span class="per">/ night</span></p>
                <span class="room-card__cta">View room</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

</Base>

<style>
.label {
  font-family: var(--font-sans); font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.12em; color: var(--stone-mid);
}
.italic { font-style: italic; }

/* ===== Image hero ===== */
.img-hero {
  position: relative; height: 70vh; min-height: 600px;
  background-size: cover; background-position: center;
  overflow: hidden;
}
.img-hero::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: 0;
  height: 6px; background: var(--terra); z-index: 4;
}
.breadcrumb {
  position: absolute; top: 100px; left: 40px; z-index: 5;
  display: flex; align-items: center; gap: 12px;
  color: rgba(255,255,255,0.7); font-family: var(--font-sans);
  font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em;
}
.breadcrumb a { transition: color 0.2s ease; }
.breadcrumb a:hover { color: var(--white); }
.breadcrumb .sep { color: rgba(255,255,255,0.35); }
.breadcrumb .current { color: var(--white); }

.img-hero__inner {
  position: absolute; bottom: 56px; left: 40px; right: 40px;
  color: var(--white); z-index: 3;
  display: flex; align-items: flex-end; justify-content: space-between; gap: 40px;
}
.img-hero__title-block { max-width: 760px; }
.img-hero__label { color: rgba(255,255,255,0.7); margin-bottom: 18px; display: block; }
.img-hero__inner h1 {
  font-family: var(--font-serif); font-size: 96px; font-weight: 300;
  letter-spacing: -0.02em; line-height: 0.98; color: var(--white); margin-bottom: 14px;
}
.italic-tag {
  font-style: italic; font-size: 36px; color: rgba(255,255,255,0.7);
  margin-left: 18px; vertical-align: 18px; font-weight: 300;
}
.img-hero__sub {
  font-family: var(--font-serif); font-style: italic; font-size: 22px;
  font-weight: 300; color: rgba(255,255,255,0.88); max-width: 540px; line-height: 1.4;
}
.img-hero__meta { display: flex; gap: 36px; align-items: flex-end; flex-shrink: 0; padding-bottom: 6px; }
.img-hero__meta-item { display: flex; flex-direction: column; gap: 4px; }
.img-hero__meta-label { font-family: var(--font-sans); font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.14em; color: rgba(255,255,255,0.55); }
.img-hero__meta-value { font-family: var(--font-serif); font-style: italic; font-size: 22px; color: var(--white); font-weight: 300; }

/* ===== Intro ===== */
.intro { background: var(--cream); padding: 120px 40px; }
.intro__grid { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1.45fr 1fr; gap: 120px; align-items: start; }
.intro__left h2 { font-family: var(--font-serif); font-size: 44px; font-weight: 300; margin-bottom: 36px; max-width: 520px; line-height: 1.1; }
.intro__left h2 .italic { display: block; color: var(--stone-mid); }
.intro__body { font-size: 16px; line-height: 1.85; color: var(--stone-dark); max-width: 520px; text-wrap: pretty; }
.intro__body p + p { margin-top: 18px; }
.intro__body .dropcap::first-letter { font-family: var(--font-serif); font-style: italic; font-weight: 300; font-size: 72px; line-height: 0.85; float: left; padding: 6px 14px 0 0; color: var(--terra); }

.features { margin-top: 56px; border-top: 1px solid var(--stone-light); padding-top: 32px; }
.features__label { display: block; margin-bottom: 24px; }
.features__list { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 18px 40px; }
.features__list li { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 14px; border-bottom: 1px solid var(--stone-light); gap: 16px; }
.features__list .key { font-family: var(--font-sans); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.1em; color: var(--stone-mid); flex-shrink: 0; }
