---
export const prerender = true;
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { client } from '../lib/sanity';
import { roomsQuery } from '../queries/rooms';
import { useTranslations } from '../i18n/utils';

const lang  = 'en';
const t     = useTranslations(lang);
const rooms = await client.fetch(roomsQuery);
---

<Base
  title="Request to Book"
  description="Book direct — no third parties, no booking fees. Each request is handled personally and answered the same day."
  transparentNav={false}
  activePage="book"
  lang={lang}
>

  <!-- ===== Hero ===== -->
  <section class="book-hero">
    <div class="book-hero__inner">
      <p class="book-hero__label">Direct booking · No third parties</p>
      <h1 class="book-hero__title">{t('book.hero.title')}</h1>
      <p class="book-hero__note">{t('book.note')}</p>
    </div>
  </section>

  <!-- ===== Form ===== -->
  <section class="book-form">
    <div class="book-form__inner">
      <EnquiryForm lang={lang} rooms={rooms} />
    </div>
  </section>

  <!-- ===== What happens next ===== -->
  <section class="steps">
    <div class="steps__inner">
      <h2>What happens next</h2>
      <p class="steps__sub">Three quiet steps between request and arrival.</p>
      <div class="steps__grid">
        <div class="step">
          <span class="step__num">01</span>
          <h3>We review your request</h3>
          <p>A person — not a calendar bot — checks the dates and your notes.</p>
        </div>
        <div class="step">
          <span class="step__num">02</span>
          <h3>We confirm by email</h3>
          <p>Usually within a few hours, always the same day.</p>
        </div>
        <div class="step">
          <span class="step__num">03</span>
          <h3>Secure payment link</h3>
          <p>We send a Stripe link to complete your reservation. Nothing is charged before then.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Guarantee ===== -->
  <section class="guarantee">
    <div class="guarantee__inner">
      <p class="guarantee__label">Best rate guaranteed</p>
      <h2>{t('book.guarantee')}</h2>
      <p>{t('book.guarantee.body')}</p>
      <div class="guarantee__perks">
        <span>✓ Lowest rate</span>
        <span>✓ Flexible 14-day cancellation</span>
        <span>✓ Complimentary welcome drink</span>
      </div>
    </div>
  </section>

</Base>

<style>
.book-hero {
  background: var(--forest);
  padding: 160px 60px 80px;
  min-height: 50vh;
  display: flex; align-items: flex-end;
}
.book-hero__inner { max-width: 760px; }
.book-hero__label {
  font-family: var(--font-sans);
  font-size: 11px; font-weight: 500;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--terra); margin-bottom: 16px;
}
.book-hero__title {
  font-family: var(--font-serif);
  font-size: 72px; font-weight: 300;
  color: var(--white); margin-bottom: 24px;
}
.book-hero__note { font-size: 15px; color: rgba(255,255,255,0.55); line-height: 1.75; }

/* ===== Form ===== */
.book-form { padding: 80px 60px; }
.book-form__inner { max-width: 720px; margin: 0 auto; }

/* ===== Steps ===== */
.steps { background: var(--cream-deep); padding: 100px 60px; }
.steps__inner { max-width: 1100px; margin: 0 auto; }
.steps h2 { font-size: 44px; font-weight: 300; margin-bottom: 8px; }
.steps__sub { font-size: 14px; color: var(--stone-mid); margin-bottom: 56px; }
.steps__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
.step { display: flex; flex-direction: column; gap: 12px; }
.step__num {
  font-family: var(--font-serif);
  font-size: 48px; font-weight: 300;
  color: var(--terra); line-height: 1;
}
.step h3 {
  font-family: var(--font-serif);
  font-size: 22px; font-weight: 400;
  color: var(--stone-dark);
}
.step p { font-size: 14px; color: var(--stone-mid); line-height: 1.75; }

/* ===== Guarantee ===== */
.guarantee { background: var(--forest); padding: 100px 60px; }
.guarantee__inner { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
.guarantee__label {
  font-family: var(--font-sans);
  font-size: 11px; font-weight: 500;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--terra);
}
.guarantee h2 {
  font-family: var(--font-serif);
  font-size: 44px; font-weight: 300;
  color: var(--white);
}
.guarantee p { font-size: 15px; color: rgba(255,255,255,0.55); line-height: 1.8; }
.guarantee__perks {
  display: flex; gap: 32px; flex-wrap: wrap;
  font-family: var(--font-sans);
  font-size: 12px; font-weight: 500;
  letter-spacing: 0.06em;
  color: rgba(255,255,255,0.7);
  margin-top: 8px;
}

/* ===== Responsive ===== */
@media (max-width: 768px) {
  .book-hero { padding: 130px 24px 60px; min-height: auto; }
  .book-hero__title { font-size: 48px; }
  .book-form { padding: 60px 24px; }
  .steps { padding: 60px 24px; }
  .steps__grid { grid-template-columns: 1fr; gap: 32px; }
  .guarantee { padding: 60px 24px; }
  .guarantee h2 { font-size: 32px; }
  .guarantee__perks { flex-direction: column; gap: 12px; }
}
</style>
