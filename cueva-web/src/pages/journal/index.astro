---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import HeroSection from '../../components/layout/HeroSection.astro';
import { client } from '../../lib/sanity';
import { JOURNAL_POSTS_QUERY } from '../../lib/sanity/queries';
import type { JournalPostListItem } from '../../types/sanity';
import { formatDate } from '../../i18n/utils';

const lang  = 'en';
const posts = await client.fetch<JournalPostListItem[]>(JOURNAL_POSTS_QUERY, { locale: lang });

const featured = posts.find(p => p.featured) ?? posts[0] ?? null;
const archive  = posts.filter(p => p !== featured);

// Fallback articles shown while Sanity content is being populated
const placeholderArticles = [
  { cat: 'Property',          title: 'La Cueva at dawn: what the mountain looks like before anyone else is awake',  excerpt: 'The hour before the sun comes over the ridge, when the valley turns the colour of unbaked bread.',       date: 'May 2026',      read: '8 min read',  color: '#7C5E3F' },
  { cat: 'Behind the Scenes', title: 'Why we chose solar: four years of off-grid decisions',                         excerpt: 'An honest accounting of what works, what doesn\'t, and what we\'d do differently.',                   date: 'April 2026',    read: '12 min read', color: '#4A5E45' },
  { cat: 'Local Area',        title: 'Desert de les Palmes: a walking guide from the property boundary',             excerpt: 'Three routes, all starting from the back gate. Cork oak, monastery ruins, a view at the end.',       date: 'March 2026',    read: '10 min read', color: '#8B9A7A' },
  { cat: 'Local Area',        title: 'Where to eat well in the Costa Azahar',                                        excerpt: 'Seven places we send guests, two we don\'t talk about, and one you should book before you arrive.',   date: 'February 2026', read: '9 min read',  color: '#A88766' },
  { cat: 'Property',          title: 'The restoration: what we kept, what we rebuilt, and why',                      excerpt: 'Two years of slow work, one beam at a time. Notes on what the old house wanted us to do.',           date: 'January 2026',  read: '15 min read', color: '#5C4838' },
  { cat: 'Seasonal',          title: 'Arriving in autumn: the best time most guests overlook',                       excerpt: 'The light is longer, the crowds are gone, the kitchen has more to work with.',                       date: 'November 2025', read: '6 min read',  color: '#B8855B' },
];
---

<Base
  title="Journal · La Cueva de Miravet"
  description="Notes from the mountain. Stories, seasonal updates, area guides and owner's notes from La Cueva de Miravet."
  onCream={true}
  activePage="journal"
  lang={lang}
>

  <!-- ===== Hero ===== -->
  <HeroSection
    eyebrow="The Journal"
    eyebrowDecor="dot"
    subline="Notes from the mountain."
    sublineVariant="tagline"
    bgScheme="cream"
    overlayStyle="none"
    size="interior"
    textAlign="left"
    contentPosition="bottom"
  >
    <Fragment slot="headline">Curated</Fragment>

    <div slot="decorative" class="hero__topo" aria-hidden="true">
      <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" fill="none" stroke="#C4622D" stroke-width="0.8">
        <path d="M-20 460 Q 200 420 420 450 T 820 430"/>
        <path d="M-20 420 Q 220 380 440 410 T 820 390"/>
        <path d="M-20 380 Q 240 340 460 370 T 820 350"/>
        <path d="M-20 340 Q 260 300 480 330 T 820 310"/>
        <path d="M-20 300 Q 280 260 500 290 T 820 270"/>
        <path d="M-20 260 Q 300 220 520 250 T 820 230"/>
        <path d="M-20 220 Q 320 180 540 210 T 820 190"/>
      </svg>
    </div>
  </HeroSection>

  <!-- ===== Featured article ===== -->
  {featured ? (
    <section class="featured">
      <div class="featured__inner">
        <div
          class="featured__img"
          role="img"
          aria-label={featured.title ?? 'Featured article'}
          style={featured.featuredImageUrl ? `background-image: url('${featured.featuredImageUrl}'); background-size: cover; background-position: center;` : ''}
          data-animate
        ></div>
        <div class="featured__body" data-animate>
          <div class="featured__tag">
            <span class="rule"></span>
            <span>{featured.category ?? 'Property'} · Featured</span>
          </div>
          <h2 class="featured__title">{featured.title}</h2>
          {featured.excerpt && <p class="featured__excerpt">{featured.excerpt}</p>}
          <div class="featured__byline">
            <span class="avatar" aria-hidden="true"></span>
            <span class="who">By {featured.author ?? 'La Cueva de Miravet'}</span>
            <span class="sep">·</span>
            <span class="when">{formatDate(featured.publishedAt, lang)}</span>
            {featured.readingMinutes && <><span class="sep">·</span><span class="when">{featured.readingMinutes} min read</span></>}
          </div>
          <a href={`/journal/${featured.slug.current}`} class="terra-link">Read article</a>
        </div>
      </div>
    </section>
  ) : (
    <section class="featured">
      <div class="featured__inner">
        <div class="featured__img" role="img" aria-label="The mountain at first light" data-animate></div>
        <div class="featured__body" data-animate>
          <div class="featured__tag">
            <span class="rule"></span>
            <span>Property · Featured</span>
          </div>
          <h2 class="featured__title">
            La Cueva at dawn:
            <span class="italic"> what the mountain looks like before anyone else is awake.</span>
          </h2>
          <p class="featured__excerpt">There is a particular hour, twenty minutes before the sun comes over the ridge, when the valley below the masia turns the colour of unbaked bread and the air is so still you can hear the goats two kilometres away.</p>
          <div class="featured__byline">
            <span class="avatar" aria-hidden="true"></span>
            <span class="who">By Javier</span>
            <span class="sep">·</span>
            <span class="when">May 2026</span>
            <span class="sep">·</span>
            <span class="when">8 min read</span>
          </div>
          <a href="/journal" class="terra-link">Read article</a>
        </div>
      </div>
    </section>
  )}

  <!-- ===== Archive ===== -->
  <section class="archive">
    <div class="archive__header" data-animate>
      <p class="archive__title">
        <span class="roman">From the archive.</span> Stories, seasons, and the things worth writing down.
      </p>
      <span class="archive__count"><strong>{posts.length > 0 ? posts.length : 24}</strong> entries · since 2022</span>
    </div>

    <!-- Filter -->
    <nav class="filter" aria-label="Filter by category" data-animate>
      <span class="filter__label"><span class="rule-sm"></span>Filter</span>
      <div class="filter__list">
        <button class="filter__item active" data-filter="all">All</button>
        <button class="filter__item" data-filter="property">Property</button>
        <button class="filter__item" data-filter="local-area">Local Area</button>
        <button class="filter__item" data-filter="seasonal">Seasonal</button>
        <button class="filter__item" data-filter="behind-the-scenes">Behind the Scenes</button>
      </div>
    </nav>

    <!-- Grid -->
    <div class="grid" data-animate>
      {archive.length > 0 ? archive.map((post) => (
        <a href={`/journal/${post.slug.current}`} class="article">
          <div class="article__img-wrap">
            {post.featuredImageUrl
              ? <img src={post.featuredImageUrl} alt={post.title ?? ''} loading="lazy" />
              : <div class="article__img" style="background-color: #7C5E3F;"></div>
            }
          </div>
          <div class="article__body">
            {post.category && <span class="article__cat">{post.category}</span>}
            <h3 class="article__title">{post.title}</h3>
            {post.excerpt && <p class="article__excerpt">{post.excerpt}</p>}
            <div class="article__meta">
              <span class="date">{formatDate(post.publishedAt, lang)}</span>
              {post.readingMinutes && <span class="read">{post.readingMinutes} min read</span>}
            </div>
          </div>
        </a>
      )) : placeholderArticles.map((a) => (
        <article class="article">
          <div class="article__img-wrap">
            <div class="article__img" style={`background-color: ${a.color};`}></div>
          </div>
          <div class="article__body">
            <span class="article__cat">{a.cat}</span>
            <h3 class="article__title">{a.title}</h3>
            <p class="article__excerpt">{a.excerpt}</p>
            <div class="article__meta">
              <span class="date">{a.date}</span>
              <span class="read">{a.read}</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="archive__more" data-animate>
      <a href="#" class="pill-btn">Load older entries</a>
    </div>
  </section>

</Base>

<style>
.italic { font-style: italic; }
.roman  { font-style: normal; }

/* Hero structure lives in HeroSection.astro — page-specific topo decoration below */
.hero__topo {
  position: absolute; top: 0; right: 0;
  width: 50%; height: 100%; pointer-events: none; opacity: 0.5; z-index: 1;
}
.hero__topo svg { width: 100%; height: 100%; }

/* ===== Featured ===== */
.featured {
  background: var(--stone-dark);
  background-image: var(--grain); background-blend-mode: multiply;
  color: var(--white); position: relative; overflow: hidden;
}
.featured::before {
  content: ""; position: absolute; inset: 0;
  background: radial-gradient(ellipse 50% 60% at 80% 30%, rgba(196,98,45,0.08) 0%, transparent 70%), radial-gradient(ellipse 60% 50% at 10% 90%, rgba(74,94,69,0.18) 0%, transparent 70%);
  pointer-events: none;
}
.featured__inner {
  position: relative; z-index: 2;
  max-width: 1400px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 1fr;
  align-items: stretch;
}
.featured__img {
  aspect-ratio: 4/5; min-height: 560px;
  background-color: #6B5544;
  background-image: var(--grain);
  background-blend-mode: multiply;
  background-size: cover; background-position: center;
  position: relative;
}
.featured__img::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(135deg, rgba(0,0,0,0) 60%, rgba(0,0,0,0.25) 100%);
}
.featured__body {
  padding: 100px 80px;
  display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
  max-width: 680px;
}
.featured__tag {
  font-family: var(--font-sans); font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.16em; color: var(--terra);
  display: inline-flex; align-items: center; gap: 14px; margin-bottom: 32px;
}
.rule { width: 28px; height: 1px; background: var(--terra); display: inline-block; }
.featured__title {
  font-family: var(--font-serif); font-weight: 300;
  font-size: 52px; line-height: 1.08; letter-spacing: -0.01em;
  color: var(--white); margin-bottom: 28px; text-wrap: balance;
}
.featured__title .italic { color: rgba(255,255,255,0.78); }
.featured__excerpt {
  font-size: 16px; line-height: 1.7;
  color: rgba(255,255,255,0.7); margin-bottom: 36px; max-width: 520px; text-wrap: pretty;
}
.featured__byline {
  display: flex; align-items: center; gap: 14px; margin-bottom: 36px;
  color: rgba(255,255,255,0.55); font-family: var(--font-sans); font-size: 12px;
}
.avatar {
  width: 36px; height: 36px; border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #8a7359 0%, #5a4a3b 70%), var(--grain);
  background-blend-mode: normal, multiply;
  flex-shrink: 0; border: 1px solid rgba(255,255,255,0.1);
}
.who { color: var(--white); font-style: italic; font-family: var(--font-serif); font-size: 16px; }
.when { color: rgba(255,255,255,0.45); }
.sep  { color: rgba(255,255,255,0.25); }
.terra-link {
  font-family: var(--font-sans); font-size: 12px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.14em; color: var(--terra);
  display: inline-flex; align-items: center; gap: 10px;
}
.terra-link::after { content: "→"; display: inline-block; transition: transform 0.3s ease; }
.terra-link:hover::after { transform: translateX(4px); }

/* ===== Archive ===== */
.archive { background: var(--cream); padding: 120px 40px 140px; }
.archive__header { max-width: 1280px; margin: 0 auto 56px; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; }
.archive__title { font-family: var(--font-serif); font-style: italic; font-weight: 300; font-size: 32px; color: var(--stone-dark); line-height: 1.1; max-width: 480px; }
.archive__count { font-family: var(--font-sans); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--stone-mid); padding-bottom: 6px; }
.archive__count strong { font-family: var(--font-serif); font-style: italic; font-weight: 300; font-size: 18px; color: var(--stone-dark); text-transform: none; letter-spacing: 0; margin-right: 6px; }
.filter { max-width: 1280px; margin: 0 auto 56px; display: flex; align-items: center; gap: 0; flex-wrap: wrap; padding-bottom: 22px; border-bottom: 1px solid var(--stone-light); }
.filter__label { font-family: var(--font-sans); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--stone-mid); margin-right: 28px; display: inline-flex; align-items: center; gap: 12px; }
.rule-sm { width: 20px; height: 1px; background: var(--stone-mid); display: inline-block; }
.filter__list { display: flex; gap: 0; flex-wrap: wrap; align-items: center; }
.filter__item {
  font-family: var(--font-sans); font-size: 12px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.12em; color: var(--stone-mid);
  padding: 6px 18px; transition: color 0.2s ease; position: relative;
  background: none; border: none; cursor: pointer;
}
.filter__item:hover { color: var(--stone-dark); }
.filter__item.active { color: var(--terra); }
.filter__item.active::after { content: ""; position: absolute; left: 18px; right: 18px; bottom: -23px; height: 1px; background: var(--terra); }
.filter__item + .filter__item::before { content: "·"; position: absolute; left: -3px; color: var(--stone-light); }
.grid { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 64px 40px; }
.article { display: flex; flex-direction: column; cursor: pointer; }
.article__img-wrap { overflow: hidden; aspect-ratio: 3/2; background-color: var(--stone-light); position: relative; }
.article__img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: opacity 0.4s ease; }
.article:hover .article__img-wrap img { opacity: 0.92; }
.article__img { width: 100%; height: 100%; background-image: var(--grain); background-blend-mode: multiply; background-size: cover; position: relative; }
.article__img::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 70%, rgba(0,0,0,0.16) 100%); }
.article:hover .article__img { opacity: 0.92; }
.article__body { padding: 22px 0 0; display: flex; flex-direction: column; }
.article__cat { font-family: var(--font-sans); font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.16em; color: var(--terra); margin-bottom: 14px; }
.article__title { font-family: var(--font-serif); font-weight: 400; font-size: 22px; line-height: 1.22; color: var(--stone-dark); margin-bottom: 10px; text-wrap: pretty; transition: color 0.2s ease; }
.article:hover .article__title { color: var(--terra); }
.article__excerpt { font-size: 13px; line-height: 1.6; color: var(--stone-mid); margin-bottom: 18px; text-wrap: pretty; }
.article__meta { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--stone-light); display: flex; align-items: center; justify-content: space-between; gap: 12px; font-family: var(--font-sans); font-size: 11px; color: var(--stone-mid); }
.article__meta .date { font-style: italic; font-family: var(--font-serif); font-size: 14px; color: var(--stone-dark); }
.article__meta .read { text-transform: uppercase; letter-spacing: 0.12em; font-size: 10px; }
.archive__more { max-width: 1280px; margin: 88px auto 0; text-align: center; padding-top: 44px; border-top: 1px solid var(--stone-light); }
.pill-btn {
  display: inline-block; border: 1px solid var(--terra); color: var(--terra);
  background: transparent; border-radius: 100px; padding: 14px 36px;
  font-family: var(--font-sans); font-size: 12px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.12em;
  transition: background 0.25s ease, color 0.25s ease;
}
.pill-btn:hover { background: var(--terra); color: var(--white); }

/* ===== Responsive ===== */
@media (max-width: 1100px) {
  .hero h1 { font-size: 96px; }
  .featured__inner { grid-template-columns: 1fr; }
  .featured__img { aspect-ratio: 16/11; min-height: 0; }
  .featured__body { padding: 72px 40px; max-width: none; }
  .featured__title { font-size: 40px; }
  .grid { grid-template-columns: 1fr 1fr; gap: 56px 32px; }
  .archive__header { flex-direction: column; align-items: flex-start; gap: 16px; }
}
@media (max-width: 768px) {
  .hero { padding: 130px 24px 48px; height: auto; min-height: 0; }
  .hero h1 { font-size: 64px; }
  .hero__sub { font-size: 20px; }
  .hero__topo { display: none; }
  .featured__body { padding: 56px 24px; }
  .featured__title { font-size: 32px; }
  .archive { padding: 80px 24px 100px; }
  .grid { grid-template-columns: 1fr; gap: 56px; max-width: 420px; margin: 0 auto; }
  .archive__more { margin-top: 64px; }
}
</style>

<script>
document.querySelectorAll('.filter__item').forEach(item => {
  item.addEventListener('click', () => {
    document.querySelectorAll('.filter__item').forEach(i => i.classList.remove('active'));
    item.classList.add('active');
  });
});
</script>
