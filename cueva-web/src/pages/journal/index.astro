---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import { client, urlFor } from '../../lib/sanity';
import { journalPostsQuery } from '../../queries/journal';
import { loc, formatDate, useTranslations } from '../../i18n/utils';

const lang  = 'en';
const t     = useTranslations(lang);
const posts = await client.fetch(journalPostsQuery);

const featured = posts[0];
const archive  = posts.slice(1);
---

<Base
  title="Journal"
  description="Notes on the land, the seasons, and the quietly extraordinary things that happen here."
  onCream={true}
  activePage="journal"
  lang={lang}
>

  <!-- Featured post -->
  {featured && (() => {
    const imgSrc = featured.coverImage
      ? urlFor(featured.coverImage).width(1200).height(700).auto('format').url()
      : null;
    return (
      <section class="featured">
        {imgSrc && (
          <div class="featured__img-wrap">
            <img src={imgSrc} alt={featured.coverImage?.alt ?? loc(featured.title, lang)} loading="eager" decoding="async" />
          </div>
        )}
        <div class="featured__body">
          <p class="featured__label">{t('journal.hero.title')}</p>
          {featured.category && <p class="featured__cat pill">{featured.category}</p>}
          <h1 class="featured__title">{loc(featured.title, lang)}</h1>
          {featured.excerpt && <p class="featured__excerpt">{loc(featured.excerpt, lang)}</p>}
          <div class="featured__meta">
            <span>{formatDate(featured.publishedAt, lang)}</span>
            {featured.readingMinutes && <span>{featured.readingMinutes} {t('journal.min')}</span>}
          </div>
          <a href={`/journal/${featured.slug.current}`} class="terra-link">{t('journal.read')}</a>
        </div>
      </section>
    );
  })()}

  <!-- Archive grid -->
  {archive.length > 0 && (
    <section class="archive">
      <div class="archive__inner">
        <div class="archive__grid">
          {archive.map((post: any) => {
            const img = post.coverImage
              ? urlFor(post.coverImage).width(640).height(420).auto('format').url()
              : null;
            return (
              <article class="article-card" data-animate>
                {img && (
                  <a href={`/journal/${post.slug.current}`} class="article-card__img">
                    <img src={img} alt={post.coverImage?.alt ?? loc(post.title, lang)} loading="lazy" decoding="async" />
                  </a>
                )}
                <div class="article-card__body">
                  {post.category && <p class="article-card__cat">{post.category}</p>}
                  <h3 class="article-card__title">
                    <a href={`/journal/${post.slug.current}`}>{loc(post.title, lang)}</a>
                  </h3>
                  {post.excerpt && <p class="article-card__excerpt">{loc(post.excerpt, lang)}</p>}
                  <div class="article-card__foot">
                    <span class="article-card__date">{formatDate(post.publishedAt, lang)}</span>
                    <a href={`/journal/${post.slug.current}`} class="terra-link">{t('journal.read')}</a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

</Base>

<style>
/* Featured */
.featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 70vh;
}
.featured__img-wrap { overflow: hidden; }
.featured__img-wrap img { width: 100%; height: 100%; object-fit: cover; }

.featured__body {
  background: var(--cream-deep);
  padding: 120px 60px 80px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16px;
}

.featured__label {
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--terra);
}
.featured__cat {
  border-color: var(--stone-light);
  color: var(--stone-mid);
  width: fit-content;
}
.featured__title { font-size: 48px; font-weight: 300; color: var(--stone-dark); }
.featured__excerpt { font-size: 15px; color: var(--stone-mid); line-height: 1.7; }
.featured__meta {
  display: flex; gap: 20px;
  font-family: var(--font-sans);
  font-size: 12px; color: var(--stone-light);
}

/* Archive */
.archive { padding: 80px 40px 120px; }
.archive__inner { max-width: 1200px; margin: 0 auto; }
.archive__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 48px 32px;
}

.article-card { display: flex; flex-direction: column; gap: 16px; }
.article-card__img { display: block; overflow: hidden; border-radius: 2px; }
.article-card__img img {
  width: 100%; aspect-ratio: 3/2; object-fit: cover;
  transition: transform 0.6s var(--ease);
}
.article-card:hover .article-card__img img { transform: scale(1.03); }

.article-card__cat {
  font-family: var(--font-sans);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--terra);
}
.article-card__title {
  font-family: var(--font-serif);
  font-size: 26px;
  font-weight: 400;
  color: var(--stone-dark);
  line-height: 1.2;
}
.article-card__title a:hover { color: var(--terra); }
.article-card__excerpt { font-size: 13px; color: var(--stone-mid); line-height: 1.7; }
.article-card__foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: auto;
}
.article-card__date { font-size: 11px; color: var(--stone-light); }

@media (max-width: 960px) {
  .featured { grid-template-columns: 1fr; }
  .featured__img-wrap { aspect-ratio: 16/9; }
  .archive__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .featured__body { padding: 60px 24px; }
  .featured__title { font-size: 36px; }
  .archive { padding: 60px 24px 80px; }
  .archive__grid { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
}
</style>
