---
import { prefix } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { RoomListItem } from '../types/sanity';

interface Props {
  room: RoomListItem;
  lang?: Lang;
}

const { room, lang = 'en' } = Astro.props;
const p = prefix(lang);

const slug  = room.slug?.current ?? '';
// Per-slug swatch colours used when no image is available
const swatchColors: Record<string, string> = {
  olivo: '#5C4838', lavanda: '#8FA59A', laurel: '#B8A48A',
  tomillo: '#7E6E58', almendro: '#6F8366', roble: '#9A8A74', hinojo: '#4A3F35',
};
const placeholderColor = swatchColors[slug] ?? '#C4A882';
---

<article class="room-card">
  <a href={`${p}/stay/${slug}`} class="room-card__img-wrap">
    {room.imageUrl
      ? <img src={room.imageUrl} alt={room.imageAlt ?? room.name ?? slug} loading="lazy" decoding="async" />
      : <div class="room-card__placeholder" style={`background-color: ${placeholderColor};`}></div>
    }
  </a>
  <div class="room-card__body">
    {room.subtitle && <p class="room-card__type">{room.subtitle}</p>}
    <h3 class="room-card__name">{room.name ?? slug}</h3>
    {room.tagline && <p class="room-card__feature">{room.tagline}</p>}
    {room.pricePerNight && <p class="room-card__price">From €{room.pricePerNight} / night</p>}
    <a href={`${p}/stay/${slug}`} class="room-card__cta">View room →</a>
  </div>
</article>

<style>
.room-card { display: flex; flex-direction: column; }

.room-card__img-wrap {
  display: block;
  overflow: hidden;
  border-radius: 160px 160px 0 0;
}
.room-card__img-wrap img {
  width: 100%; height: 320px;
  object-fit: cover;
  transition: transform 0.6s ease;
  display: block;
}
.room-card__placeholder {
  width: 100%; height: 320px;
  background-image: var(--grain);
  background-blend-mode: multiply;
  transition: transform 0.6s ease;
}
.room-card:hover .room-card__img-wrap img,
.room-card:hover .room-card__placeholder { transform: scale(1.04); }

.room-card__body { padding: 24px 8px; }

.room-card__type {
  font-family: var(--font-sans); font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.12em;
  color: var(--terra); margin-bottom: 6px;
}
.room-card__name {
  font-family: var(--font-serif);
  font-size: 22px; font-weight: 400;
  color: var(--stone-dark);
}
.room-card__feature {
  font-size: 13px; color: var(--stone-mid);
  margin: 8px 0; line-height: 1.55;
}
.room-card__price {
  font-size: 14px; color: var(--stone-dark);
  font-weight: 500; margin-top: 16px;
}
.room-card__cta {
  display: inline-block; margin-top: 12px;
  font-family: var(--font-sans);
  font-size: 12px; font-weight: 500;
  color: var(--terra); text-transform: uppercase; letter-spacing: 0.08em;
  transition: opacity 0.2s ease;
}
.room-card__cta:hover { text-decoration: underline; }
</style>
