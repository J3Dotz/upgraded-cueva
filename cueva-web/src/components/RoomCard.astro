---
import { urlFor } from '../lib/sanity';
import { useTranslations, loc, prefix } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  room: {
    name: { en?: string; es?: string };
    slug: { current: string };
    tagline?: { en?: string; es?: string };
    swatchColor?: string;
    bedConfig?: { en?: string; es?: string };
    view?: { en?: string; es?: string };
    priceFrom?: number;
    images?: Array<{ asset: { _ref: string }; alt?: string }>;
  };
  lang?: Lang;
}

const { room, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const p = prefix(lang);

const imgSrc = room.images?.[0]
  ? urlFor(room.images[0]).width(480).height(640).auto('format').url()
  : null;

const placeholderColor = room.swatchColor ?? '#C4A882';
---

<article class="room-card">
  <a href={`${p}/stay/${room.slug.current}`} class="room-card__img-wrap">
    {imgSrc
      ? <img src={imgSrc} alt={room.images?.[0]?.alt ?? loc(room.name, lang)} loading="lazy" decoding="async" />
      : <div class="room-card__placeholder" style={`background-color: ${placeholderColor};`}></div>
    }
  </a>
  <div class="room-card__body">
    <h3 class="room-card__name">
      {loc(room.name, lang)}
      {lang === 'en' && room.name?.es && <span class="room-card__es">{room.name.es}</span>}
    </h3>
    {room.bedConfig && <p class="room-card__feature">{loc(room.bedConfig, lang)}</p>}
    {room.view && <p class="room-card__view">{loc(room.view, lang)}</p>}
    {room.priceFrom && <p class="room-card__price">From €{room.priceFrom} / night</p>}
    <a href={`${p}/stay/${room.slug.current}`} class="room-card__cta">{t('stay.view')} →</a>
  </div>
</article>

<style>
.room-card { display: flex; flex-direction: column; }

.room-card__img-wrap {
  display: block;
  overflow: hidden;
  border-radius: 160px 160px 0 0;
}
.room-card__img-wrap img {
  width: 100%; height: 320px;
  object-fit: cover;
  transition: transform 0.6s ease;
  display: block;
}
.room-card__placeholder {
  width: 100%; height: 320px;
  background-image: var(--grain);
  background-blend-mode: multiply;
  transition: transform 0.6s ease;
}
.room-card:hover .room-card__img-wrap img,
.room-card:hover .room-card__placeholder { transform: scale(1.04); }

.room-card__body { padding: 24px 8px; }

.room-card__name {
  font-family: var(--font-serif);
  font-size: 22px; font-weight: 400;
  color: var(--stone-dark);
}
.room-card__es {
  font-style: italic; font-weight: 300;
  color: var(--stone-mid); font-size: 17px; margin-left: 6px;
}
.room-card__feature {
  font-family: var(--font-sans); font-size: 12px;
  color: var(--stone-mid); text-transform: uppercase;
  letter-spacing: 0.08em; margin: 6px 0;
}
.room-card__view { font-size: 13px; color: var(--stone-mid); }
.room-card__price {
  font-size: 14px; color: var(--stone-dark);
  font-weight: 500; margin-top: 16px;
}
.room-card__cta {
  display: inline-block; margin-top: 12px;
  font-family: var(--font-sans);
  font-size: 12px; font-weight: 500;
  color: var(--terra); text-transform: uppercase; letter-spacing: 0.08em;
  transition: opacity 0.2s ease;
}
.room-card__cta:hover { text-decoration: underline; }
</style>
