---
import { urlFor } from '../lib/sanity';

interface Props {
  node: { asset?: any; alt?: string; caption?: string };
  index: number;
  isInline: boolean;
}

const { node } = Astro.props;
---

{node.asset && (
  <figure>
    <img src={urlFor(node.asset).width(800).url()} alt={node.alt ?? ''} loading="lazy" />
    {node.caption && <figcaption>{node.caption}</figcaption>}
  </figure>
)}
