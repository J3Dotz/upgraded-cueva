---
interface Props {
  /** Short label above the headline */
  eyebrow?: string;
  /** Decorative element prepended to the eyebrow */
  eyebrowDecor?: 'none' | 'rule' | 'pip' | 'dot';
  /** Body copy below the headline */
  subline?: string;
  /** Body: small sans text (default). Tagline: large serif italic (journal). */
  sublineVariant?: 'body' | 'tagline';
  /**
   * Background colour scheme.
   * stone        — #3A3228 + grain (homepage fallback)
   * forest       — var(--forest) + grain (stay)
   * forest-lit   — var(--forest) + radial gradients + grain (experiences)
   * stone-dark   — var(--stone-dark) + grain (location)
   * cream        — var(--cream), no grain (journal)
   */
  bgScheme?: 'stone' | 'forest' | 'forest-lit' | 'stone-dark' | 'cream';
  /** URL of a background image. When set with mediaType="image", renders as CSS bg. */
  bgImage?: string;
  /** URL of a background video. Requires mediaType="video". */
  videoUrl?: string;
  /** Poster image URL shown before the video loads. */
  videoPoster?: string;
  /** What kind of background media to render. */
  mediaType?: 'colour' | 'image' | 'video';
  /**
   * Overlay gradient style rendered above the media.
   * stone — warm stone gradient (homepage)
   * black — neutral black gradient (stay)
   * none  — no overlay
   */
  overlayStyle?: 'none' | 'stone' | 'black';
  /**
   * Hero height.
   * full     — 100vh / min 720px (homepage)
   * interior — 50vh  / min 440px (all other pages)
   */
  size?: 'full' | 'interior';
  /** Horizontal text alignment. Also controls flex-axis alignment. */
  textAlign?: 'left' | 'center';
  /**
   * Where to position the inner content vertically.
   * center — justify-content: center (homepage, stay, location)
   * bottom — align-items: flex-end + bottom padding (experiences, journal)
   */
  contentPosition?: 'center' | 'bottom';
  /**
   * When true, the inner container becomes a two-column grid.
   * Column 1: eyebrow + headline + subline.
   * Column 2: <slot name="extra-inner"> (e.g. coordinates widget).
   */
  innerColumns?: boolean;
  /** Renders a 4px terra accent bar pinned to the bottom edge (experiences). */
  bottomBar?: boolean;
}

const {
  eyebrow,
  eyebrowDecor = 'none',
  subline,
  sublineVariant = 'body',
  bgScheme = 'forest',
  bgImage,
  videoUrl,
  videoPoster,
  mediaType = 'colour',
  overlayStyle = 'none',
  size = 'interior',
  textAlign = 'left',
  contentPosition = 'center',
  innerColumns = false,
  bottomBar = false,
} = Astro.props;

const showVideo = mediaType === 'video' && !!videoUrl;
const showBgImage =
  (mediaType === 'image' && !!bgImage) ||
  (mediaType === 'video' && !videoUrl && !!bgImage);

const bgColourByScheme: Record<string, string> = {
  stone:       '#3A3228',
  forest:      'var(--forest)',
  'forest-lit':'var(--forest)',
  'stone-dark':'var(--stone-dark)',
  cream:       'var(--cream)',
};

// Inline style is only used when rendering an actual image URL (dynamic value).
const sectionStyle = showBgImage
  ? `background-color:${bgColourByScheme[bgScheme] ?? '#3A3228'}; background-image: linear-gradient(180deg,rgba(58,50,40,.4) 0%,rgba(58,50,40,0) 30%,rgba(58,50,40,0) 70%,rgba(58,50,40,.6) 100%), var(--grain), url('${bgImage}'); background-size:cover; background-position:center;`
  : undefined;
---

<section
  class:list={[
    'page-hero',
    `page-hero--${size}`,
    `page-hero--${bgScheme}`,
    `page-hero--align-${textAlign}`,
    `page-hero--pos-${contentPosition}`,
    bottomBar && 'page-hero--bottom-bar',
  ]}
  style={sectionStyle}
>
  {showVideo && (
    <video
      class="page-hero__video"
      autoplay
      muted
      loop
      playsinline
      poster={videoPoster}
      aria-hidden="true"
    >
      <source src={videoUrl} type="video/mp4" />
    </video>
  )}

  <!-- Page-specific decorative elements (topo SVGs, etc.) -->
  <slot name="decorative" />

  {overlayStyle !== 'none' && (
    <div class:list={['page-hero__overlay', `page-hero__overlay--${overlayStyle}`]} aria-hidden="true" />
  )}

  <div
    class:list={[
      'page-hero__inner',
      innerColumns && 'page-hero__inner--columns',
    ]}
  >
    <!-- Primary content: eyebrow + headline + subline -->
    <div data-animate>
      {eyebrow && (
        <p class="label page-hero__label">
          {eyebrowDecor === 'rule' && <span class="page-hero__decor page-hero__decor--rule" aria-hidden="true" />}
          {eyebrowDecor === 'pip'  && <span class="page-hero__decor page-hero__decor--pip"  aria-hidden="true" />}
          {eyebrowDecor === 'dot'  && <span class="page-hero__decor page-hero__decor--dot"  aria-hidden="true" />}
          <span>{eyebrow}</span>
        </p>
      )}

      <h1 class="page-hero__headline">
        <slot name="headline" />
      </h1>

      {subline && (
        <p class:list={[
          'page-hero__body',
          sublineVariant === 'tagline' && 'page-hero__body--tagline',
        ]}>
          {subline.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      )}
    </div>

    <!-- Extra inner content (e.g. coordinates widget on location page) -->
    <slot name="extra-inner" />
  </div>

  <!-- Content outside the inner container (availability form, scroll indicators) -->
  <slot />
</section>

<style>
/* ─── Base ─────────────────────────────────────────────────────────────── */
.page-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 0 40px;
  color: var(--white);
}

/* ─── Size variants ─────────────────────────────────────────────────────── */
.page-hero--full     { height: 100vh; min-height: 720px; }
.page-hero--interior { height: 50vh;  min-height: 440px; }

/* ─── Content position ──────────────────────────────────────────────────── */
.page-hero--pos-center { justify-content: center; }
.page-hero--pos-bottom { justify-content: flex-end; padding-bottom: 72px; }

/* ─── Text / flex alignment ─────────────────────────────────────────────── */
.page-hero--align-center { align-items: center; }
.page-hero--align-left   { align-items: flex-start; }

/* ─── Background schemes ────────────────────────────────────────────────── */
.page-hero--stone,
.page-hero--forest,
.page-hero--forest-lit,
.page-hero--stone-dark {
  background-image: var(--grain);
  background-blend-mode: multiply;
}

.page-hero--stone      { background-color: #3A3228; }
.page-hero--forest     { background-color: var(--forest); }
.page-hero--forest-lit { background-color: var(--forest); }
.page-hero--stone-dark { background-color: var(--stone-dark); }
.page-hero--cream      { background-color: var(--cream); color: var(--stone-dark); }

/* Experiences: layered radial gradients over forest */
.page-hero--forest-lit {
  background-image:
    radial-gradient(ellipse 80% 60% at 70% 30%, rgba(74,94,69,0.55) 0%, transparent 70%),
    radial-gradient(ellipse 90% 70% at 20% 80%, rgba(36,58,48,0.6) 0%, transparent 65%),
    var(--grain);
  background-blend-mode: normal, normal, multiply;
}

/* Ambient radial light on dark backgrounds */
.page-hero--stone::before,
.page-hero--forest::before,
.page-hero--forest-lit::before,
.page-hero--stone-dark::before {
  content: "";
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at center, rgba(255,255,255,0.035) 0%, transparent 65%);
  pointer-events: none;
  z-index: 1;
}

/* Terra accent bar at bottom edge (experiences page) */
.page-hero--bottom-bar::after {
  content: "";
  position: absolute; bottom: 0; left: 0; right: 0;
  height: 4px;
  background: var(--terra);
  z-index: 4;
}

/* ─── Video ─────────────────────────────────────────────────────────────── */
.page-hero__video {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  z-index: 0;
}

/* ─── Overlay gradients ─────────────────────────────────────────────────── */
.page-hero__overlay {
  position: absolute; inset: 0;
  pointer-events: none;
  z-index: 1;
}
.page-hero__overlay--stone {
  background: linear-gradient(
    180deg,
    rgba(58,50,40,0.4) 0%,
    rgba(58,50,40,0) 30%,
    rgba(58,50,40,0) 70%,
    rgba(58,50,40,0.6) 100%
  );
}
.page-hero__overlay--black {
  background: linear-gradient(
    180deg,
    rgba(0,0,0,0.25) 0%,
    rgba(0,0,0,0) 30%,
    rgba(0,0,0,0) 70%,
    rgba(0,0,0,0.35) 100%
  );
}

/* ─── Inner container ───────────────────────────────────────────────────── */
.page-hero__inner {
  position: relative; z-index: 2;
  width: 100%;
  max-width: 1280px;
}

/* Center-aligned pages get narrower, centered inner */
.page-hero--align-center .page-hero__inner {
  max-width: 760px;
  text-align: center;
  /* Slight upward shift to visually balance the weight below (availability form) */
}

/* Homepage: nudge inner up to balance the availability form below */
.page-hero--full .page-hero__inner {
  margin-top: -40px;
}

/* Two-column inner layout (location: headline + coords side by side) */
.page-hero__inner--columns {
  max-width: 1400px;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: flex-end;
  gap: 80px;
}

/* ─── Eyebrow / label ───────────────────────────────────────────────────── */
.page-hero__label {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
  color: rgba(255,255,255,0.65);
}

.page-hero--align-center .page-hero__label {
  justify-content: center;
}

.page-hero--cream .page-hero__label {
  color: var(--stone-mid);
}

/* Decorative eyebrow elements */
.page-hero__decor--rule {
  display: inline-block;
  width: 36px; height: 1px;
  background: rgba(255,255,255,0.4);
  flex-shrink: 0;
}
.page-hero__decor--pip {
  display: inline-block;
  width: 6px; height: 6px;
  background: var(--terra);
  border-radius: 50%;
  flex-shrink: 0;
}
.page-hero__decor--dot {
  display: inline-block;
  width: 4px; height: 4px;
  background: var(--terra);
  border-radius: 50%;
  flex-shrink: 0;
}

/* ─── Headline ──────────────────────────────────────────────────────────── */
.page-hero__headline {
  font-family: var(--font-serif);
  font-size: 84px;
  font-weight: 300;
  letter-spacing: -0.02em;
  line-height: 1.05;
  color: var(--white);
  margin-bottom: 22px;
}

/* Homepage keeps its original 72px */
.page-hero--full .page-hero__headline {
  font-size: 72px;
  margin-bottom: 32px;
}

/* Light-background headline */
.page-hero--cream .page-hero__headline {
  color: var(--stone-dark);
}

/* Italic spans inside headlines */
.page-hero__headline :global(.italic) {
  font-style: italic;
}

/* Italic on dark bg */
.page-hero--stone     .page-hero__headline :global(.italic),
.page-hero--forest    .page-hero__headline :global(.italic),
.page-hero--forest-lit .page-hero__headline :global(.italic),
.page-hero--stone-dark .page-hero__headline :global(.italic) {
  color: rgba(255,255,255,0.95);
}

/* Italic on cream bg */
.page-hero--cream .page-hero__headline :global(.italic) {
  color: var(--stone-dark);
}

/* dim modifier used on experiences page */
.page-hero__headline :global(.dim) {
  color: rgba(255,255,255,0.7);
}

/* ─── Subline / body ────────────────────────────────────────────────────── */
.page-hero__body {
  max-width: 540px;
  color: rgba(255,255,255,0.78);
  font-size: 15px;
  line-height: 1.75;
}

.page-hero--align-center .page-hero__body {
  margin: 0 auto;
}

.page-hero--cream .page-hero__body {
  color: var(--stone-mid);
}

/* Tagline variant: large serif italic (journal page) */
.page-hero__body--tagline {
  font-family: var(--font-serif);
  font-style: italic;
  font-weight: 300;
  font-size: 26px;
  line-height: 1.3;
  color: var(--stone-mid);
}

/* ─── Responsive ────────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .page-hero__headline         { font-size: 60px; }
  .page-hero--full .page-hero__headline { font-size: 56px; }
  .page-hero__inner--columns   { grid-template-columns: 1fr; gap: 32px; }
}

@media (max-width: 768px) {
  .page-hero { padding: 0 24px; }
  .page-hero--interior {
    height: auto;
    padding-top: 140px;
    padding-bottom: 80px;
    min-height: 380px;
  }
  .page-hero--pos-bottom { padding-bottom: 56px; }
  .page-hero__headline         { font-size: 44px; }
  .page-hero--full .page-hero__headline { font-size: 44px; }
}
</style>
