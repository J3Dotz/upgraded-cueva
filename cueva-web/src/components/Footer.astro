---
import { useTranslations, prefix } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { SiteSettings } from '../types/sanity';

interface Props {
  lang?: Lang;
  activePage?: string;
  siteSettings?: SiteSettings | null;
}

const { lang = 'en', activePage, siteSettings } = Astro.props;
const t = useTranslations(lang);
const p = prefix(lang);

const siteName       = siteSettings?.siteName       ?? 'La Cueva de Miravet';
const tagline        = siteSettings?.tagline         ?? null;
const email          = siteSettings?.email           ?? 'hola@lacuevademiravet.com';
const address        = siteSettings?.address         ?? 'Cabanes, Castellón, Spain';
const copyright      = siteSettings?.copyright       ?? null;
const instagramHref  = siteSettings?.social?.instagram ?? '#';
const facebookHref   = siteSettings?.social?.facebook  ?? '#';
---

<footer>
  <div class="footer__grid">

    <!-- Brand col -->
    <div class="footer__col">
      <p class="footer__logo">{siteName}</p>
      {tagline && <p class="footer__tagline">"{tagline}"</p>}
      <div class="footer__social">
        <a href={instagramHref} aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
          </svg>
        </a>
        <a href={facebookHref} aria-label="Facebook" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/><path d="M11 8 v8 l-1 5"/><path d="M8 13 q1 2 3 2 q3 0 3 -3 q0 -2 -2 -2 q-2 0 -2 2"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Nav col -->
    <div class="footer__col">
      <span class="footer__col-label">Explore</span>
      <nav class="footer__links" aria-label="Footer navigation">
        <a href={`${p}/stay`}        class:list={{ active: activePage === 'stay'        }}>{t('nav.stay')}</a>
        <a href={`${p}/location`}    class:list={{ active: activePage === 'location'    }}>{t('nav.location')}</a>
        <a href={`${p}/journal`}     class:list={{ active: activePage === 'journal'     }}>{t('nav.journal')}</a>
        <a href={`${p}/book`}        class:list={{ active: activePage === 'book'        }}>{t('nav.book')}</a>
      </nav>
    </div>

    <!-- Contact col -->
    <div class="footer__col">
      <span class="footer__col-label">Contact</span>
      <div class="footer__contact">
        <a href={`mailto:${email}`} class="footer__email">{email}</a>
        <p class="footer__address">{address}</p>
      </div>
      <div class="footer__sep"></div>
      <p class="footer__guarantee">Best rate guaranteed — book direct.</p>
    </div>

  </div>

  <div class="footer__bottom">
    <p class="footer__copy">{copyright ?? `© ${new Date().getFullYear()} ${siteName} · ${t('footer.rights')}`}</p>
    <p class="footer__credit">A Nomada project</p>
  </div>
</footer>

<style>
footer {
  background: var(--stone-dark);
  color: rgba(255,255,255,0.65);
  padding: 80px 40px 40px;
}

.footer__grid {
  max-width: 1200px; margin: 0 auto;
  display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 60px;
}

.footer__logo {
  font-family: var(--font-serif);
  font-size: 20px; font-weight: 400;
  color: var(--white); margin-bottom: 12px;
}

.footer__tagline {
  font-family: var(--font-serif); font-style: italic;
  font-size: 14px; color: rgba(255,255,255,0.5);
  max-width: 320px;
}

.footer__social {
  margin-top: 24px; display: flex; gap: 18px;
}
.footer__social a {
  color: rgba(255,255,255,0.4);
  transition: color 0.2s ease;
  display: inline-flex;
}
.footer__social a:hover { color: var(--white); }

.footer__col-label {
  font-family: var(--font-sans);
  font-size: 11px; font-weight: 500;
  text-transform: uppercase; letter-spacing: 0.12em;
  color: rgba(255,255,255,0.35);
  display: block; margin-bottom: 20px;
}

.footer__links {
  display: flex; flex-direction: column; gap: 10px;
}
.footer__links a {
  font-size: 14px; color: rgba(255,255,255,0.65);
  transition: color 0.2s ease;
}
.footer__links a:hover,
.footer__links a.active { color: var(--white); }

.footer__contact { display: flex; flex-direction: column; gap: 8px; }
.footer__email {
  font-size: 13px; color: rgba(255,255,255,0.65);
  transition: color 0.2s;
}
.footer__email:hover { color: var(--white); }
.footer__address { font-size: 13px; color: rgba(255,255,255,0.4); }

.footer__sep {
  height: 1px; background: rgba(255,255,255,0.1);
  margin: 20px 0;
}
.footer__guarantee {
  font-size: 12px; color: rgba(255,255,255,0.4); font-style: italic;
}

.footer__bottom {
  max-width: 1200px; margin: 60px auto 0;
  padding-top: 24px;
  border-top: 1px solid rgba(255,255,255,0.08);
  display: flex; justify-content: space-between;
}
.footer__copy { font-size: 11px; color: rgba(255,255,255,0.3); }
.footer__credit { font-size: 11px; color: rgba(255,255,255,0.25); }

@media (max-width: 768px) {
  footer { padding: 60px 24px 32px; }
  .footer__grid { grid-template-columns: 1fr; gap: 40px; }
  .footer__bottom { flex-direction: column; gap: 8px; }
}
</style>
